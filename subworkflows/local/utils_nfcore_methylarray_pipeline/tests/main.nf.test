                new File(dir, 'samplesheet.csv').text = [
                    'sample,idat_red,idat_grn,plate,reported_sex,reported_age',
                    "S1,${dir}/207059430159_R01C01_Red.idat,${dir}/207059430159_R01C01_Grn.idat,P1,F,20",
                    "S2,${dir}/207059430159_R02C01_Red.idat,${dir}/207059430159_R02C01_Grn.idat,P1,M,30",
                    "S3,${dir}/207805830137_R01C01_Red.idat,${dir}/207805830137_R01C01_Grn.idat,P2,M,40",
                ].join('\n') + '\n'
                new File(dir, 'models.yml').text = [
                    '- name: age',
                    '  trait: reported_age',
                    '  trait_type: continuous',
                    '  covariates: [reported_sex, "@technical"]',
                    '  block: plate',
                ].join('\n') + '\n'
                outdir = "$outputDir"
                input  = "${dir}/samplesheet.csv"
                models = "${dir}/models.yml"
            }
            workflow {
                """
                input[0] = false
                input[1] = true
                input[2] = false
                input[3] = []
                input[4] = params.outdir
                input[5] = params.input
                input[6] = params.phenotypes
                input[7] = params.models
                input[8] = false
                input[9] = false
                input[10] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).any { line -> line.contains("model 'age' uses 'plate' both as block and as covariate") } }
            )
        }
    }

    test("phenotype column reusing a samplesheet name - fails") {

        when {
            params {
                def dir = new File("$outputDir/fixtures")
                dir.mkdirs()
                ['207059430159_R01C01', '207059430159_R02C01', '207805830137_R01C01'].each { prefix ->
                    new File(dir, "${prefix}_Red.idat").text = 'placeholder'
                    new File(dir, "${prefix}_Grn.idat").text = 'placeholder'
                }
                new File(dir, 'samplesheet.csv').text = [
                    'sample,idat_red,idat_grn,plate,reported_sex,reported_age',
                    "S1,${dir}/207059430159_R01C01_Red.idat,${dir}/207059430159_R01C01_Grn.idat,P1,F,20",
                    "S2,${dir}/207059430159_R02C01_Red.idat,${dir}/207059430159_R02C01_Grn.idat,P1,M,30",
                    "S3,${dir}/207805830137_R01C01_Red.idat,${dir}/207805830137_R01C01_Grn.idat,P2,M,40",
                ].join('\n') + '\n'
                new File(dir, 'phenotypes.csv').text = [
                    'sample,plate,bmi',
                    'S1,P1,21.5',
                ].join('\n') + '\n'
                outdir = "$outputDir"
                input  = "${dir}/samplesheet.csv"
                phenotypes = "${dir}/phenotypes.csv"
            }
            workflow {
                """
                input[0] = false
                input[1] = true
                input[2] = false
                input[3] = []
                input[4] = params.outdir
                input[5] = params.input
                input[6] = params.phenotypes
                input[7] = params.models
                input[8] = false
                input[9] = false
                input[10] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).any { line -> line.contains('reuse samplesheet or derived covariate names; rename them: plate') } }
            )
        }
    }

    test("binary trait without a reference level - fails schema validation") {

        when {
            params {
                def dir = new File("$outputDir/fixtures")
                dir.mkdirs()
                ['207059430159_R01C01', '207059430159_R02C01', '207805830137_R01C01'].each { prefix ->
                    new File(dir, "${prefix}_Red.idat").text = 'placeholder'
                    new File(dir, "${prefix}_Grn.idat").text = 'placeholder'
                }
                new File(dir, 'samplesheet.csv').text = [
                    'sample,idat_red,idat_grn,plate,reported_sex,reported_age',
                    "S1,${dir}/207059430159_R01C01_Red.idat,${dir}/207059430159_R01C01_Grn.idat,P1,F,20",
                    "S2,${dir}/207059430159_R02C01_Red.idat,${dir}/207059430159_R02C01_Grn.idat,P1,M,30",
                    "S3,${dir}/207805830137_R01C01_Red.idat,${dir}/207805830137_R01C01_Grn.idat,P2,M,40",
                ].join('\n') + '\n'
                new File(dir, 'models.yml').text = [
                    '- name: sex',
                    '  trait: reported_sex',
                    '  trait_type: binary',
                ].join('\n') + '\n'
                outdir = "$outputDir"
                input  = "${dir}/samplesheet.csv"
                models = "${dir}/models.yml"
            }
            workflow {
                """
                input[0] = false
                input[1] = true
                input[2] = false
                input[3] = []
                input[4] = params.outdir
                input[5] = params.input
                input[6] = params.phenotypes
                input[7] = params.models
                input[8] = false
                input[9] = false
                input[10] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).any { line -> line.contains('Binary and categorical traits need a reference level') } }
            )
        }
    }
}
