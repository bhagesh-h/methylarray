                    'sample,idat_red,idat_grn,plate,reported_sex,reported_age',
                    "S1,${dir}/207059430159_R01C01_Red.idat,${dir}/207059430159_R01C01_Grn.idat,P1,F,20",
                    "S2,${dir}/207059430159_R02C01_Red.idat,${dir}/207059430159_R02C01_Grn.idat,P1,M,30",
                    "S3,${dir}/207805830137_R01C01_Red.idat,${dir}/207805830137_R01C01_Grn.idat,P2,M,40",
                ].join('\n') + '\n'
                new File(dir, 'models.yml').text = [
                    '- name: bmi',
                    '  trait: bmi',
                    '  trait_type: continuous',
                    '  covariates: [reported_age, waist]',
                ].join('\n') + '\n'
                outdir = "$outputDir"
                input  = "${dir}/samplesheet.csv"
                models = "${dir}/models.yml"
            }
            workflow {
                """
                input[0] = false
                input[1] = true
                input[2] = false
                input[3] = []
                input[4] = params.outdir
                input[5] = params.input
                input[6] = params.phenotypes
                input[7] = params.models
                input[8] = false
                input[9] = false
                input[10] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).any { line -> line.contains('not in the samplesheet, the phenotype table or the derived covariates: bmi, waist') } }
            )
        }
    }

    test("model using its block as a covariate through a token - fails") {

        when {
            params {
                def dir = new File("$outputDir/fixtures")
                dir.mkdirs()
                ['207059430159_R01C01', '207059430159_R02C01', '207805830137_R01C01'].each { prefix ->
                    new File(dir, "${prefix}_Red.idat").text = 'placeholder'
