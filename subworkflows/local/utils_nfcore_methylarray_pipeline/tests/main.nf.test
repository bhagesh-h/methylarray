nextflow_workflow {

    name "Test Workflow PIPELINE_INITIALISATION"
    script "../main.nf"
    workflow "PIPELINE_INITIALISATION"

    tag "subworkflows"
    tag "subworkflows_local"
    tag "pipeline_initialisation"

    test("EPIC v2 samplesheet - parsed into one element per array") {

        when {
            params {
                outdir = "$outputDir"
                input  = "${projectDir}/tests/data/samplesheet_test.csv"
            }
            workflow {
                """
                input[0] = false
                input[1] = true
                input[2] = false
                input[3] = []
                input[4] = params.outdir
                input[5] = params.input
                input[6] = false
                input[7] = false
                input[8] = false
                """
            }
        }

        then {
            def rows = workflow.out.samplesheet
            def become_1 = rows.find { row -> row[0].id == 'BeCOME_1' }
            assertAll(
                { assert workflow.success },
                { assert rows.size() == 6 },
                { assert rows.collect { row -> row[0].id }.sort() == ['BeCOME_1', 'BeCOME_2', 'BeCOME_5', 'BeCOME_6', 'CALERIE_1', 'CALERIE_1_rep'] },
                { assert become_1[0].sentrix_id == '207059430159' },
                { assert become_1[0].sentrix_position == 'R01C01' },
                { assert become_1[0].sentrix_row == 'R01' },
                { assert become_1[0].reported_sex == 'F' },
                { assert become_1[0].exclude == false },
                { assert become_1[1].toString().endsWith('GSM8723468_207059430159_R01C01_Red.idat.gz') },
                { assert become_1[2].toString().endsWith('GSM8723468_207059430159_R01C01_Grn.idat.gz') },
                { assert rows.findAll { row -> row[0].replicate_group == 'CALERIE_1' }.size() == 2 }
            )
        }
    }

    test("IDAT files from different arrays - fails") {

        when {
            params {
                outdir = "$outputDir"
                input  = "${projectDir}/tests/data/invalid/mismatched_pair.csv"
            }
            workflow {
                """
                input[0] = false
                input[1] = true
                input[2] = false
                input[3] = []
                input[4] = params.outdir
                input[5] = params.input
                input[6] = false
                input[7] = false
                input[8] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert workflow.stderr.any { line -> line.contains('do not belong to the same array') } }
            )
        }
    }

    test("IDAT file used twice - fails") {

        when {
            params {
                outdir = "$outputDir"
                input  = "${projectDir}/tests/data/invalid/duplicated_idat.csv"
            }
            workflow {
                """
                input[0] = false
                input[1] = true
                input[2] = false
                input[3] = []
                input[4] = params.outdir
                input[5] = params.input
                input[6] = false
                input[7] = false
                input[8] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert workflow.stderr.any { line -> line.contains('appear in more than one row') } }
            )
        }
    }

    test("excluded sample without a reason - fails") {

        when {
            params {
                outdir = "$outputDir"
                input  = "${projectDir}/tests/data/invalid/exclude_without_reason.csv"
            }
            workflow {
                """
                input[0] = false
                input[1] = true
                input[2] = false
                input[3] = []
                input[4] = params.outdir
                input[5] = params.input
                input[6] = false
                input[7] = false
                input[8] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert workflow.stderr.any { line -> line.contains('exclude_reason') } }
            )
        }
    }
}
