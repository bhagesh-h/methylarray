nextflow_workflow {

    name "Test Workflow PIPELINE_INITIALISATION"
    script "../main.nf"
    workflow "PIPELINE_INITIALISATION"

    tag "subworkflows"
    tag "subworkflows_local"
    tag "pipeline_initialisation"

    // The tests write placeholder IDAT files and samplesheets into the test's
    // output directory, so they run offline and do not depend on remote data.
    // Only file names are checked here; the content is never read.

    test("valid samplesheet - one element per array with Sentrix fields") {

        when {
            params {
                def dir = new File("$outputDir/fixtures")
                dir.mkdirs()
                ['207059430159_R01C01', '207059430159_R02C01', '207805830137_R01C01'].each { prefix ->
                    new File(dir, "${prefix}_Red.idat").text = 'placeholder'
                    new File(dir, "${prefix}_Grn.idat").text = 'placeholder'
                }
                new File(dir, 'samplesheet.csv').text = [
                    'sample,idat_red,idat_grn,sentrix_id,plate,reported_sex,reported_age,replicate_group',
                    "S1,${dir}/207059430159_R01C01_Red.idat,${dir}/207059430159_R01C01_Grn.idat,207059430159,1,F,20,",
                    "S2,${dir}/207059430159_R02C01_Red.idat,${dir}/207059430159_R02C01_Grn.idat,,1,M,30,R1",
                    "S3,${dir}/207805830137_R01C01_Red.idat,${dir}/207805830137_R01C01_Grn.idat,,2,M,30.5,R1",
                ].join('\n') + '\n'
                outdir = "$outputDir"
                input  = "${dir}/samplesheet.csv"
            }
            workflow {
                """
                input[0] = false
                input[1] = true
                input[2] = false
                input[3] = []
                input[4] = params.outdir
                input[5] = params.input
                input[6] = false
                input[7] = false
                input[8] = false
                """
            }
        }

        then {
            def rows = workflow.out.samplesheet
            def s1 = rows.find { row -> row[0].id == 'S1' }
            assertAll(
                { assert workflow.success },
                { assert rows.size() == 3 },
                { assert rows.collect { row -> row[0].id }.sort() == ['S1', 'S2', 'S3'] },
                { assert s1[0].sentrix_id == '207059430159' },
                { assert s1[0].sentrix_position == 'R01C01' },
                { assert s1[0].sentrix_row == 'R01' },
                { assert s1[0].plate == '1' },
                { assert rows.find { row -> row[0].id == 'S3' }[0].sentrix_id == '207805830137' },
                { assert s1[0].reported_sex == 'F' },
                { assert s1[0].exclude == false },
                { assert s1[1].toString().endsWith('207059430159_R01C01_Red.idat') },
                { assert s1[2].toString().endsWith('207059430159_R01C01_Grn.idat') },
                { assert rows.findAll { row -> row[0].replicate_group == 'R1' }.size() == 2 }
            )
        }
    }

    test("IDAT files from different arrays - fails") {

        when {
            params {
                def dir = new File("$outputDir/fixtures")
                dir.mkdirs()
                new File(dir, '207059430159_R01C01_Red.idat').text = 'placeholder'
                new File(dir, '207059430159_R02C01_Grn.idat').text = 'placeholder'
                new File(dir, 'samplesheet.csv').text = [
                    'sample,idat_red,idat_grn',
                    "S1,${dir}/207059430159_R01C01_Red.idat,${dir}/207059430159_R02C01_Grn.idat",
                ].join('\n') + '\n'
                outdir = "$outputDir"
                input  = "${dir}/samplesheet.csv"
            }
            workflow {
                """
                input[0] = false
                input[1] = true
                input[2] = false
                input[3] = []
                input[4] = params.outdir
                input[5] = params.input
                input[6] = false
                input[7] = false
                input[8] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert workflow.stderr.any { line -> line.contains('do not belong to the same array') } }
            )
        }
    }

    test("IDAT file used twice - fails") {

        when {
            params {
                def dir = new File("$outputDir/fixtures")
                dir.mkdirs()
                new File(dir, '207059430159_R01C01_Red.idat').text = 'placeholder'
                new File(dir, '207059430159_R01C01_Grn.idat').text = 'placeholder'
                new File(dir, 'samplesheet.csv').text = [
                    'sample,idat_red,idat_grn',
                    "S1,${dir}/207059430159_R01C01_Red.idat,${dir}/207059430159_R01C01_Grn.idat",
                    "S1_copy,${dir}/207059430159_R01C01_Red.idat,${dir}/207059430159_R01C01_Grn.idat",
                ].join('\n') + '\n'
                outdir = "$outputDir"
                input  = "${dir}/samplesheet.csv"
            }
            workflow {
                """
                input[0] = false
                input[1] = true
                input[2] = false
                input[3] = []
                input[4] = params.outdir
                input[5] = params.input
                input[6] = false
                input[7] = false
                input[8] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert workflow.stderr.any { line -> line.contains('appear in more than one row') } }
            )
        }
    }

    test("Sentrix ID that contradicts the file name - fails") {

        when {
            params {
                def dir = new File("$outputDir/fixtures")
                dir.mkdirs()
                new File(dir, '207059430159_R01C01_Red.idat').text = 'placeholder'
                new File(dir, '207059430159_R01C01_Grn.idat').text = 'placeholder'
                new File(dir, 'samplesheet.csv').text = [
                    'sample,idat_red,idat_grn,sentrix_id',
                    "S1,${dir}/207059430159_R01C01_Red.idat,${dir}/207059430159_R01C01_Grn.idat,207059430160",
                ].join('\n') + '\n'
                outdir = "$outputDir"
                input  = "${dir}/samplesheet.csv"
            }
            workflow {
                """
                input[0] = false
                input[1] = true
                input[2] = false
                input[3] = []
                input[4] = params.outdir
                input[5] = params.input
                input[6] = false
                input[7] = false
                input[8] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert workflow.stderr.any { line -> line.contains('but its IDAT files name 207059430159') } }
            )
        }
    }

    test("excluded sample without a reason - fails") {

        when {
            params {
                def dir = new File("$outputDir/fixtures")
                dir.mkdirs()
                new File(dir, '207059430159_R01C01_Red.idat').text = 'placeholder'
                new File(dir, '207059430159_R01C01_Grn.idat').text = 'placeholder'
                new File(dir, 'samplesheet.csv').text = [
                    'sample,idat_red,idat_grn,exclude',
                    "S1,${dir}/207059430159_R01C01_Red.idat,${dir}/207059430159_R01C01_Grn.idat,true",
                ].join('\n') + '\n'
                outdir = "$outputDir"
                input  = "${dir}/samplesheet.csv"
            }
            workflow {
                """
                input[0] = false
                input[1] = true
                input[2] = false
                input[3] = []
                input[4] = params.outdir
                input[5] = params.input
                input[6] = false
                input[7] = false
                input[8] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert workflow.stderr.any { line -> line.contains('exclude_reason') } }
            )
        }
    }
}
