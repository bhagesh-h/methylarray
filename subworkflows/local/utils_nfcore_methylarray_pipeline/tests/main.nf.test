                new File(dir, 'samplesheet.csv').text = [
                    'sample,idat_red,idat_grn,sentrix_id',
                    "S1,${dir}/207059430159_R01C01_Red.idat,${dir}/207059430159_R01C01_Grn.idat,207059430160",
                ].join('\n') + '\n'
                outdir = "$outputDir"
                input  = "${dir}/samplesheet.csv"
            }
            workflow {
                """
                input[0] = false
                input[1] = true
                input[2] = false
                input[3] = []
                input[4] = params.outdir
                input[5] = params.input
                input[6] = params.phenotypes
                input[7] = params.models
                input[8] = false
                input[9] = false
                input[10] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).any { line -> line.contains('but its IDAT files name 207059430159') } }
            )
        }
