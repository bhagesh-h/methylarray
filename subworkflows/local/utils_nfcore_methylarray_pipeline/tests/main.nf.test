                new File(dir, 'samplesheet.csv').text = [
                    'sample,idat_red,idat_grn,exclude',
                    "S1,${dir}/207059430159_R01C01_Red.idat,${dir}/207059430159_R01C01_Grn.idat,true",
                ].join('\n') + '\n'
                outdir = "$outputDir"
                input  = "${dir}/samplesheet.csv"
            }
            workflow {
                """
                input[0] = false
                input[1] = true
                input[2] = false
                input[3] = []
                input[4] = params.outdir
                input[5] = params.input
                input[6] = params.phenotypes
                input[7] = params.models
                input[8] = false
                input[9] = false
                input[10] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).any { line -> line.contains('exclude_reason') } }
            )
        }
    }

    test("phenotypes and models - validated and emitted") {

        when {
            params {
                def dir = new File("$outputDir/fixtures")
                dir.mkdirs()
                ['207059430159_R01C01', '207059430159_R02C01', '207805830137_R01C01'].each { prefix ->
                    new File(dir, "${prefix}_Red.idat").text = 'placeholder'
                    new File(dir, "${prefix}_Grn.idat").text = 'placeholder'
                }
                new File(dir, 'samplesheet.csv').text = [
                    'sample,idat_red,idat_grn,plate,reported_sex,reported_age',
                    "S1,${dir}/207059430159_R01C01_Red.idat,${dir}/207059430159_R01C01_Grn.idat,P1,F,20",
                    "S2,${dir}/207059430159_R02C01_Red.idat,${dir}/207059430159_R02C01_Grn.idat,P1,M,30",
                    "S3,${dir}/207805830137_R01C01_Red.idat,${dir}/207805830137_R01C01_Grn.idat,P2,M,40",
                ].join('\n') + '\n'
                new File(dir, 'phenotypes.tsv').text = [
                    'sample\tbmi\tsmoker',
                    'S1\t21.5\tno',
                    'S2\tNA\tyes',
                    'S3\t30.1\tno',
                    'S9\t25.0\tyes',
                ].join('\n') + '\n'
                new File(dir, 'models.yml').text = [
                    '- name: bmi',
                    '  trait: bmi',
                    '  trait_type: continuous',
                    '  transform: log',
                    '  covariates: [reported_age, reported_sex, "@cells", "@technical", sentrix_row, cc_Mono]',
                    '- name: smoking',
                    '  trait: smoker',
                    '  trait_type: binary',
                    '  reference: "no"',
                    '  block: plate',
                    '  covariates: [reported_age, predicted_sex]',
                    '  subset: {column: reported_sex, equals: M}',
                ].join('\n') + '\n'
                outdir = "$outputDir"
                input  = "${dir}/samplesheet.csv"
                phenotypes = "${dir}/phenotypes.tsv"
                models     = "${dir}/models.yml"
            }
            workflow {
                """
                input[0] = false
                input[1] = true
                input[2] = false
                input[3] = []
                input[4] = params.outdir
                input[5] = params.input
                input[6] = params.phenotypes
                input[7] = params.models
                input[8] = false
                input[9] = false
                input[10] = false
                """
            }
        }

        then {
            def models = workflow.out.models
            def log_lines = new File("${metaDir}/nextflow.log").readLines()
            def bmi = models.find { model -> model.name == 'bmi' }
            def smoking = models.find { model -> model.name == 'smoking' }
            assertAll(
                { assert workflow.success },
                { assert models.size() == 2 },
                { assert bmi.transform == 'log' },
                { assert bmi.min_n == 50 },
                { assert bmi.skip_dmr == false },
                { assert smoking.transform == 'none' },
                { assert smoking.reference == 'no' },
                { assert smoking.subset == [column: 'reported_sex', equals: 'M'] },
                { assert workflow.out.phenotypes.size() == 1 },
                { assert workflow.out.phenotypes[0].toString().endsWith('phenotypes.tsv') },
                { assert log_lines.any { line -> line.contains('1 sample(s) are not in the samplesheet') && line.contains('S9') } },
                { assert log_lines.any { line -> line.contains('Phenotype table: 3 samples, 2 columns') } },
                { assert !log_lines.any { line -> line.contains('21.5') || line.contains('30.1') } }
            )
        }
    }

    test("model naming an unknown column - fails") {

        when {
            params {
                def dir = new File("$outputDir/fixtures")
                dir.mkdirs()
                ['207059430159_R01C01', '207059430159_R02C01', '207805830137_R01C01'].each { prefix ->
                    new File(dir, "${prefix}_Red.idat").text = 'placeholder'
