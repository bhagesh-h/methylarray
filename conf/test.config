/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run bhagesh-h/methylarray -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Input data
    // Public EPIC v2 whole-blood arrays from GEO GSE286313 (Zhuang et al. 2025)
    input  = "${projectDir}/tests/data/samplesheet_test.csv"
}

// The test IDATs are read from the NCBI GEO HTTPS server, which answers with
// HTTP 503 when many files are requested at once: stage them a few at a time
threadPool.FileTransfer.maxThreads = 4
filePorter.maxRetries = 10
