/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'SESAME_CACHE' {
        publishDir = [
            path: { "${params.outdir}/references" },
            mode: params.publish_dir_mode,
            enabled: params.save_reference
        ]
    }

    withName: 'SESAME_PREPROCESS' {
        ext.args   = { "--prep ${params.sesame_prep} --min_beads ${params.min_beads} --detection_pval ${params.detection_pval} --platform ${params.platform}" }
        publishDir = [ enabled: false ]
    }

    withName: 'SESAME_BUILDSE' {
        publishDir = [
            [
                path: { "${params.outdir}/preprocessing/sesame" },
                mode: params.publish_dir_mode,
                pattern: '*_se'
            ],
            [
                path: { "${params.outdir}/qc/sesame" },
                mode: params.publish_dir_mode,
                pattern: '*_qc.tsv'
            ]
        ]
    }

    withName: 'MINFI_PREPROCESS' {
        ext.args   = { "--method ${params.preprocessing} --minfi_norm ${params.minfi_norm} --enmix_quantile ${params.enmix_quantile} --min_beads ${params.min_beads} --detection_pval ${params.detection_pval} --platform ${params.platform} --chunk_size ${params.minfi_chunk_size}" }
        publishDir = [
            [
                path: { "${params.outdir}/preprocessing/${meta.id}" },
                mode: params.publish_dir_mode,
                pattern: '*_se'
            ],
            [
                path: { "${params.outdir}/qc/${meta.id}" },
                mode: params.publish_dir_mode,
                pattern: '*_qc.tsv'
            ]
        ]
    }

    withName: 'EWASTOOLS_QC' {
        ext.args   = { "--platform ${params.platform} --snp_outlier_threshold ${params.snp_outlier_threshold}" }
        publishDir = [
            path: { "${params.outdir}/qc/ewastools" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') || filename.endsWith('_mqc.tsv') ? null : filename }
        ]
    }

    withName: 'SAMPLEQC_SUMMARY' {
        ext.args   = { "--method ${params.preprocessing} --max_undetected_fraction ${params.max_undetected_fraction} --snp_outlier_threshold ${params.snp_outlier_threshold}" }
        publishDir = [
            path: { "${params.outdir}/qc" },
            mode: params.publish_dir_mode,
            pattern: 'sample_qc{.tsv,_retained.txt}'
        ]
    }

    withName: 'PROBES_ANNOTATE' {
        ext.args   = { "--platform ${params.platform}" }
        publishDir = [
            path: { "${params.outdir}/references" },
            mode: params.publish_dir_mode,
            enabled: params.save_reference,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'PROBES_FILTER' {
        ext.args   = { "--detection_pval ${params.detection_pval} --probe_fail_fraction ${params.probe_fail_fraction} --bead_fail_fraction ${params.bead_fail_fraction} --crosshyb_filter ${params.crosshyb_filter} --snp_mask ${params.snp_mask} --keep_sex_chr ${params.keep_sex_chr} --replicate_probe_strategy ${params.replicate_probe_strategy} --illumina_filter ${params.illumina_filter}" }
        publishDir = [
            [
                path: { "${params.outdir}/probe_filter" },
                mode: params.publish_dir_mode,
                pattern: '*{_filtered_se,_attrition.tsv,_exclusions.tsv.gz}'
            ]
        ]
    }

    withName: 'EPIDISH_RPC' {
        ext.args   = { "--min_coverage ${params.min_reference_coverage}" }
        publishDir = [
            path: { "${params.outdir}/cell_composition" },
            mode: params.publish_dir_mode,
            pattern: 'cell_fractions{.tsv,_reference_coverage.tsv,_idol_agreement.tsv}'
        ]
    }

    withName: 'CLOCKS_COMPUTE' {
        ext.args   = { "--clocks ${params.clocks} --dunedinpace_min_probes ${params.dunedinpace_min_probes}" }
        publishDir = [
            path: { "${params.outdir}/clocks" },
            mode: params.publish_dir_mode,
            pattern: 'clocks{.tsv,_coverage.tsv,_weights.tsv,_robust.tsv}'
        ]
    }

    withName: 'MEQTL_PREPARE' {
        ext.args   = { "--meqtl_p ${params.meqtl_p}" }
        publishDir = [
            path: { "${params.outdir}/meqtl" },
            mode: params.publish_dir_mode,
            pattern: 'meqtl_cpgs{.tsv,_summary.tsv}'
        ]
    }

    withName: 'EXPLORATION_PCA' {
        ext.args   = { "--n_variable_cpgs ${params.n_variable_cpgs} --n_pcs ${params.n_pcs} --n_ctrl_pcs ${params.n_ctrl_pcs}" }
        publishDir = [
            path: { "${params.outdir}/exploration" },
            mode: params.publish_dir_mode,
            pattern: 'pca_{ctrl_pcs,ctrl_pca_variance,scores,variance,associations,outliers}.tsv'
        ]
    }

    withName: 'VARIANCE_PARTITION' {
        ext.args   = { "--n_cpgs ${params.variance_partition_cpgs}" }
        publishDir = [
            path: { "${params.outdir}/exploration" },
            mode: params.publish_dir_mode,
            pattern: 'variance_partition{.tsv.gz,_summary.tsv}'
        ]
    }

    withName: 'ANCESTRY_PCS' {
        ext.args   = { "--n_ancestry_pcs ${params.n_ancestry_pcs}" }
        publishDir = [
            path: { "${params.outdir}/exploration" },
            mode: params.publish_dir_mode,
            pattern: 'ancestry_pcs{,_variance,_summary,_associations}.tsv'
        ]
    }

    withName: 'EWAS_LIMMA' {
        ext.args   = { "--p_epigenome_wide ${params.p_epigenome_wide} --p_suggestive ${params.p_suggestive} --cell_ewas ${!params.skip_cell_ewas} --cells ${params.ewas_cells} --outlier_iqr ${params.ewas_outlier_iqr}" }
        publishDir = [
            path: { "${params.outdir}/ewas/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'EWAS_SUMMARY' {
        ext.args   = { "--p_epigenome_wide ${params.p_epigenome_wide}" }
        publishDir = [
            path: { "${params.outdir}/ewas" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'ewas_summary.tsv' || (filename == 'ewas_summary_meqtl.tsv' && params.meqtl) || (filename == 'ewas_summary_cells.tsv' && !params.skip_cell_ewas) || filename == 'ewas_summary_comparison.tsv' ? filename : null }
        ]
    }

    withName: 'DMR_CALL' {
        ext.args   = { "--lambda ${params.dmr_lambda} --C ${params.dmr_c} --min_cpgs ${params.dmr_min_cpgs}" }
        publishDir = [
            path: { "${params.outdir}/dmr/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') || filename.endsWith('_mqc.tsv') ? null : filename }
        ]
    }

    withName: 'ENRICHMENT_MISSMETHYL' {
        ext.args   = { "--min_hits ${params.enrichment_min_hits} --collections ${params.enrichment_collections ?: 'none'}" }
        publishDir = [
            path: { "${params.outdir}/enrichment/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') || filename.endsWith('_mqc.tsv') ? null : filename }
        ]
    }

    withName: 'KYCG_CACHE' {
        ext.args   = { "--databases ${params.kycg_databases}" }
        publishDir = [
            path: { "${params.outdir}/references" },
            mode: params.publish_dir_mode,
            enabled: params.save_reference
        ]
    }

    withName: 'ENRICHMENT_KYCG' {
        ext.args   = { "--min_hits ${params.enrichment_min_hits} --platform ${params.platform}" }
        publishDir = [
            path: { "${params.outdir}/enrichment/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') || filename.endsWith('_mqc.tsv') ? null : filename }
        ]
    }

    withName: 'DNAM_SCORES' {
        ext.args   = { "--scores ${params.dnam_scores}" }
        publishDir = [
            path: { "${params.outdir}/dnam_scores" },
            mode: params.publish_dir_mode,
            pattern: 'dnam_scores{.tsv,_coverage.tsv,_weights.tsv}'
        ]
    }

    withName: 'BIOMARKERS_ASSOCIATE' {
        publishDir = [
            path: { "${params.outdir}/biomarkers" },
            mode: params.publish_dir_mode,
            pattern: 'biomarkers_*.tsv',
            saveAs: { filename -> filename.endsWith('_mqc.tsv') ? null : filename }
        ]
    }

    withName: 'EXPORT_GEO' {
        publishDir = [
            path: { "${params.outdir}/geo" },
            mode: params.publish_dir_mode,
            pattern: 'geo_*'
        ]
    }

    withName: 'REPORT_QUARTO' {
        publishDir = [
            path: { "${params.outdir}/report" },
            mode: params.publish_dir_mode,
            pattern: '{methylarray_report.html,figures}'
        ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode
        ]
    }

}
