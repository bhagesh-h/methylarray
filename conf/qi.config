/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file with the quality control and probe rules of Qi et al. (2025)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Their published script was written for EPIC v1; the probe lists are replaced by
    their EPIC v2 counterparts (docs/usage.md lists every rule). Any value can be
    overridden on the command line.

    Use as follows:
        nextflow run bhagesh-h/methylarray -profile qi,<docker/singularity> --input samplesheet.csv --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    // Noob values of minfi; arrays with a call rate of at most 96% at P 0.01 fail
    preprocessing           = 'minfi'
    minfi_norm              = 'noob'
    min_beads               = 3
    detection_pval          = 0.01
    max_undetected_fraction = 0.04

    // Probes: detection or beads in more than 10% of the arrays, cross-reactive and
    // polymorphic probes (Zhou and Peters for EPIC v2, Pidsley for the probes shared
    // with EPIC v1), sex chromosomes, and Illumina's lists when they are given
    probe_fail_fraction     = 0.1
    bead_fail_fraction      = 0.1
    crosshyb_filter         = 'blat'
    snp_mask                = 'eur'
    keep_sex_chr            = false
    illumina_filter         = true
    exclude_probes          = 'https://static-content.springer.com/esm/art%3A10.1186%2Fs13059-016-1066-1/MediaObjects/13059_2016_1066_MOESM1_ESM.csv'

    // With the Illumina lists removed, 85 to 90% of the cell-type reference CpGs remain
    min_reference_coverage  = 0.85

    // Association models: IDOL cell fractions, M-values beyond 3 IQR set to missing
    ewas_cells              = 'idol'
    ewas_outlier_iqr        = 3
}
