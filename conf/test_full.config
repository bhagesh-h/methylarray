/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a full size pipeline test.

    Use as follows:
        nextflow run bhagesh-h/methylarray -profile test_full,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'Full test dataset to check pipeline function'

    // Input data for full size test
    // Public EPIC v2 whole-blood arrays from GEO GSE286313 (Zhuang et al. 2025)
    input = "${projectDir}/tests/data/samplesheet_test_full.csv"

}

// The test IDATs are read from the NCBI GEO HTTPS server, which answers with
// HTTP 503 when many files are requested at once: stage them a few at a time
threadPool.FileTransfer.maxThreads = 4
filePorter.maxRetries = 10
