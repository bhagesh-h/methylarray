#!/usr/bin/env bash
#
# nfdev: run the methylarray developer toolchain inside containers.
#
# Developer use only. End users run the pipeline with their own Nextflow
# installation and do not need this script.
#
# Configuration is read from an untracked env file (default: <repo>/.nfdev.env,
# override with NFDEV_ENV). Variables:
#   NFDEV_OUT_ROOT   absolute path that receives every output, work directory,
#                    test result, cache and log (required)
#   NFDEV_DATA_DIRS  colon-separated absolute paths mounted read-only (optional)
#   NFDEV_IMAGE      devkit image tag (default: methylarray-devkit:dev)
#   NFDEV_APPTAINER_IMAGE  Apptainer devkit image tag (default: methylarray-apptainer-kit:dev)
#   NFDEV_JAVA_OPTS  JVM options for Nextflow (default: -Xms512m -Xmx4g)
#   NFDEV_DIND_IMAGE Docker-in-Docker daemon image (default: docker:29.9.3-dind)

set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ENV_FILE="${NFDEV_ENV:-${REPO}/.nfdev.env}"

usage() {
    cat <<EOF
Usage: dev/nfdev [--engine docker] <command> [args...]

Commands:
  build              Build the devkit image from dev/docker/devkit
  shell              Interactive shell in the devkit container
  nextflow <args>    Run Nextflow (launch directory: \$NFDEV_OUT_ROOT)
  exec <cmd...>      Run any command in the devkit container (working directory: repo)
  test [args]        Run nf-test in the repository (work directory: \$NFDEV_OUT_ROOT/tests/nf-test)
  lint               Lint an export of the staged tree (\$NFDEV_OUT_ROOT/tests/lint/<time>) with
                     nf-core pipelines lint and nextflow lint, then run prek in the repository
  metro              Render docs/images/metro_map.svg and a 1000 px preview PNG
  dind-stop          Stop and remove the Docker-in-Docker daemon container (dind engine)

Engines:
  docker             Docker outside of Docker through the host socket (default)
  dind               Docker in Docker: tasks run on a separate daemon in a sidecar container
  apptainer          Apptainer inside a privileged container (developer workstation only);
                     use with -profile apptainer or -profile singularity
  conda              Tasks run in micromamba environments inside the devkit container;
                     use with -profile conda or -profile mamba

Configuration file: ${ENV_FILE}
EOF
}

die() { echo "nfdev: $*" >&2; exit 1; }

[[ -f "${ENV_FILE}" ]] || die "configuration file not found: ${ENV_FILE} (see the header of this script)"
# shellcheck disable=SC1090
source "${ENV_FILE}"

: "${NFDEV_OUT_ROOT:?NFDEV_OUT_ROOT must be set in ${ENV_FILE}}"
NFDEV_DATA_DIRS="${NFDEV_DATA_DIRS:-}"
NFDEV_IMAGE="${NFDEV_IMAGE:-methylarray-devkit:dev}"
NFDEV_APPTAINER_IMAGE="${NFDEV_APPTAINER_IMAGE:-methylarray-apptainer-kit:dev}"
NFDEV_JAVA_OPTS="${NFDEV_JAVA_OPTS:--Xms512m -Xmx4g}"
NFDEV_DIND_IMAGE="${NFDEV_DIND_IMAGE:-docker:29.9.3-dind}"
DIND_NAME="nfdev-dind"
DIND_NETWORK="nfdev-net"

[[ "${NFDEV_OUT_ROOT}" = /* ]] || die "NFDEV_OUT_ROOT must be an absolute path"
[[ -d "${NFDEV_OUT_ROOT}" ]] || die "NFDEV_OUT_ROOT does not exist: ${NFDEV_OUT_ROOT}"

ENGINE="docker"
if [[ "${1:-}" == "--engine" ]]; then
    ENGINE="${2:-}"
    shift 2
fi
COMMAND="${1:-}"
[[ -n "${COMMAND}" ]] || { usage; exit 1; }
shift

# Engine-specific image and container options.
case "${ENGINE}" in
    docker)
        IMAGE="${NFDEV_IMAGE}"
        engine_opts=( --group-add "$(stat -c %g /var/run/docker.sock)"
                      -v /var/run/docker.sock:/var/run/docker.sock )
        ;;
    apptainer)
        # Apptainer needs mount namespaces, which the host only grants to a
        # privileged container (unprivileged user namespaces are restricted).
        IMAGE="${NFDEV_APPTAINER_IMAGE}"
        engine_opts=( --privileged
                      --env APPTAINER_CACHEDIR="${NFDEV_OUT_ROOT}/cache/apptainer"
                      --env NXF_APPTAINER_CACHEDIR="${NFDEV_OUT_ROOT}/cache/apptainer"
                      --env NXF_SINGULARITY_CACHEDIR="${NFDEV_OUT_ROOT}/cache/apptainer" )
        ;;
    dind)
        IMAGE="${NFDEV_IMAGE}"
        engine_opts=( --network "${DIND_NETWORK}"
                      --env DOCKER_HOST="tcp://docker:2376"
                      --env DOCKER_TLS_VERIFY=1
                      --env DOCKER_CERT_PATH=/certs/client
                      -v nfdev-dind-certs:/certs:ro )
        ;;
    conda)
        # No container engine: tasks run in micromamba environments created
        # inside this container. Environments and packages are cached under
        # the output root so they survive between runs.
        IMAGE="${NFDEV_IMAGE}"
        engine_opts=( --env NXF_CONDA_CACHEDIR="${NFDEV_OUT_ROOT}/cache/conda/envs"
                      --env CONDA_PKGS_DIRS="${NFDEV_OUT_ROOT}/cache/conda/pkgs" )
        ;;
    *) die "engine '${ENGINE}' is not implemented yet" ;;
esac

mkdir -p "${NFDEV_OUT_ROOT}/logs" "${NFDEV_OUT_ROOT}/cache/home" "${NFDEV_OUT_ROOT}/cache/nextflow" \
         "${NFDEV_OUT_ROOT}/cache/apptainer" "${NFDEV_OUT_ROOT}/cache/conda/envs" "${NFDEV_OUT_ROOT}/cache/conda/pkgs" \
         "${NFDEV_OUT_ROOT}/tests/nf-test" "${NFDEV_OUT_ROOT}/tests/metro"

LOG="${NFDEV_OUT_ROOT}/logs/nfdev_$(date +%Y%m%d_%H%M%S)_${ENGINE}_${COMMAND}.log"

# Mounts at identical absolute paths (path parity), so that the host Docker
# daemon resolves the bind mounts that Nextflow generates for task containers.
mounts=( -v "${REPO}:${REPO}"
         -v "${NFDEV_OUT_ROOT}:${NFDEV_OUT_ROOT}" )
if [[ -n "${NFDEV_DATA_DIRS}" ]]; then
    IFS=':' read -r -a data_dirs <<< "${NFDEV_DATA_DIRS}"
    for d in "${data_dirs[@]}"; do
        [[ "${d}" = /* && -d "${d}" ]] || die "data directory must be an existing absolute path: ${d}"
        mounts+=( -v "${d}:${d}:ro" )
    done
fi

# Start the Docker-in-Docker daemon if it is not running. It mounts the same
# paths as the devkit container so that task bind mounts resolve inside it.
# Its TLS certificate is issued for the name "docker", so that is its network alias.
start_dind() {
    if [[ -n "$(docker ps --quiet --filter "name=^${DIND_NAME}$" --filter status=running)" ]]; then
        return 0
    fi
    docker network inspect "${DIND_NETWORK}" >/dev/null 2>&1 || docker network create "${DIND_NETWORK}" >/dev/null
    docker run --detach --name "${DIND_NAME}" --privileged \
        --network "${DIND_NETWORK}" --network-alias docker \
        --env DOCKER_TLS_CERTDIR=/certs \
        -v nfdev-dind-certs:/certs \
        -v nfdev-dind-storage:/var/lib/docker \
        "${mounts[@]}" \
        "${NFDEV_DIND_IMAGE}" >/dev/null
    local _
    for _ in $(seq 1 60); do
        if docker exec "${DIND_NAME}" docker info >/dev/null 2>&1; then
            # Let the unprivileged devkit user read the client certificates.
            docker exec "${DIND_NAME}" chown -R "$(id -u):$(id -g)" /certs/client
            return 0
        fi
        sleep 1
    done
    die "the Docker-in-Docker daemon did not start; see: docker logs ${DIND_NAME}"
}

tty_flags=()
[[ -t 0 && -t 1 ]] && tty_flags=( -it )

run_in_devkit() {
    local workdir="$1"; shift
    [[ "${ENGINE}" == "dind" ]] && start_dind
    local cmd=( docker run --rm --init "${tty_flags[@]}"
        --user "$(id -u):$(id -g)"
        "${engine_opts[@]}"
        "${mounts[@]}"
        --workdir "${workdir}"
        --env HOME="${NFDEV_OUT_ROOT}/cache/home"
        --env NXF_HOME="${NFDEV_OUT_ROOT}/cache/nextflow"
        --env NXF_OPTS="${NFDEV_JAVA_OPTS}"
        --env NXF_ANSI_LOG=false
        --env NFT_WORKDIR="${NFDEV_OUT_ROOT}/tests/nf-test"
        "${IMAGE}" "$@" )
    printf '%q ' "${cmd[@]}" > "${LOG}"
    printf '\n\n' >> "${LOG}"
    "${cmd[@]}" 2>&1 | tee -a "${LOG}"
    return "${PIPESTATUS[0]}"
}

case "${COMMAND}" in
    build)
        DOCKER_BUILDKIT=0 docker build -t "${NFDEV_IMAGE}" "${REPO}/dev/docker/devkit" 2>&1 | tee "${LOG}"
        if [[ "${ENGINE}" == "apptainer" ]]; then
            DOCKER_BUILDKIT=0 docker build --build-arg DEVKIT_IMAGE="${NFDEV_IMAGE}" \
                -t "${NFDEV_APPTAINER_IMAGE}" "${REPO}/dev/docker/apptainer-kit" 2>&1 | tee -a "${LOG}"
        fi
        ;;
    shell)
        run_in_devkit "${REPO}" bash
        ;;
    nextflow)
        run_in_devkit "${NFDEV_OUT_ROOT}" nextflow "$@"
        ;;
    exec)
        run_in_devkit "${REPO}" "$@"
        ;;
    test)
        run_in_devkit "${REPO}" nf-test test "$@"
        ;;
    lint)
        # Lint exactly what would be committed: the git index, exported outside
        # the repository, so untracked local material (such as ref/) is ignored
        # and no lint artefacts are written into the repository.
        # The export is committed to a throwaway git repository because some
        # nf-core lint tests behave differently outside a git checkout (as in CI).
        lint_dir="${NFDEV_OUT_ROOT}/tests/lint/$(date +%Y%m%d_%H%M%S)"
        git -C "${REPO}" checkout-index --all --prefix="${lint_dir}/"
        git -C "${lint_dir}" init --quiet
        git -C "${lint_dir}" add --all
        git -C "${lint_dir}" -c user.name=nfdev -c user.email=nfdev@localhost commit --quiet --message "lint snapshot"
        run_in_devkit "${lint_dir}" bash -c 'nf-core pipelines lint && nextflow lint .'
        run_in_devkit "${REPO}" prek run --all-files
        ;;
    metro)
        run_in_devkit "${REPO}" bash -c "nf-metro render assets/metro_map.mmd -o docs/images/metro_map.svg --embed-font --validate \
            && nf-metro render assets/metro_map.mmd -o '${NFDEV_OUT_ROOT}/tests/metro/metro_map_preview_light_1000px.png' --mode light --raster-width 1000 \
            && nf-metro render assets/metro_map.mmd -o '${NFDEV_OUT_ROOT}/tests/metro/metro_map_preview_dark_1000px.png' --mode dark --raster-width 1000"
        ;;
    dind-stop)
        docker rm --force "${DIND_NAME}" >/dev/null 2>&1 || true
        echo "stopped ${DIND_NAME} (the image store volume nfdev-dind-storage is kept)"
        ;;
    -h|--help|help)
        usage
        ;;
    *)
        usage
        die "unknown command: ${COMMAND}"
        ;;
esac
