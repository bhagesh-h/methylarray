nextflow_process {

    name "Test Process EWAS_LIMMA"
    script "../main.nf"
    process "EWAS_LIMMA"

    tag "modules"
    tag "modules_local"
    tag "ewas"
    tag "ewas/limma"

    // Simulated data (make_fixture.R): 40 arrays, 2,000 CpGs; CpGs 1-20 are
    // associated with 'score', CpGs 21-40 with 'smoker'

    test("continuous trait with every covariate token") {

        tag "fast"

        when {
            process {
                """
                input[0] = [
                    [ id: 'score' ],
                    file("$moduleTestDir/model_score.json", checkIfExists: true),
                    file("$moduleTestDir/test_se", checkIfExists: true),
                    file("$moduleTestDir/samples.tsv", checkIfExists: true),
                    file("$moduleTestDir/sample_qc.tsv", checkIfExists: true),
                    file("$moduleTestDir/phenotypes.tsv", checkIfExists: true),
                    file("$moduleTestDir/cell_fractions.tsv", checkIfExists: true),
                    file("$moduleTestDir/ctrl_pcs.tsv", checkIfExists: true),
                    file("$moduleTestDir/ancestry_pcs.tsv", checkIfExists: true),
                    []
                ]
                """
            }
        }

        then {
            def summary = new groovy.json.JsonSlurper().parse(path(process.out.summary[0][1]).toFile())
            def top = path(process.out.top[0][1]).readLines().drop(1).take(20).collect { line -> line.split('\t')[0] }
            def stats = summary.contrasts.score
            assertAll(
                { assert process.success },
                // two arrays have no score; the tokens expand to sex, five cell lineages, two control PCs and two ancestry PCs
                { assert summary.n == 38 && summary.status == 'tested' },
                { assert summary.covariates == ['age', 'predicted_sex', 'cc_CD4T', 'cc_CD8T', 'cc_B', 'cc_NK', 'cc_Mono', 'ctrlpc1', 'ctrlpc2', 'ancestry_pc1', 'ancestry_pc2', 'plate'] },
                // the 20 planted CpGs are the top 20 and pass FDR < 0.05, with at most two false positives
                { assert top.sort() == (1..20).collect { i -> String.format('cg%08d', i) } },
                { assert stats.hits_fdr >= 20 && stats.hits_fdr <= 22 },
                { assert stats.lambda > 0.8 && stats.lambda < 1.3 },
                { assert path(process.out.design_check[0][1]).text.contains('trait ~ plate') },
                // every lineage of the fixture has a median fraction above 5% and no inflation
                { assert summary.cells.status == 'run' && summary.cells.lineages.values().every { l -> l.status == 'ok' && l.median_fraction > 0.05 } },
                { assert snapshot(process.out.versions).match() }
            )
        }
    }

    test("cell lineages below the minimum fraction are unreliable") {

        tag "fast"
        config "./nextflow_cells.config"

        when {
            process {
                """
                input[0] = [
                    [ id: 'score' ],
                    file("$moduleTestDir/model_score.json", checkIfExists: true),
                    file("$moduleTestDir/test_se", checkIfExists: true),
                    file("$moduleTestDir/samples.tsv", checkIfExists: true),
                    file("$moduleTestDir/sample_qc.tsv", checkIfExists: true),
                    file("$moduleTestDir/phenotypes.tsv", checkIfExists: true),
                    file("$moduleTestDir/cell_fractions.tsv", checkIfExists: true),
                    file("$moduleTestDir/ctrl_pcs.tsv", checkIfExists: true),
                    file("$moduleTestDir/ancestry_pcs.tsv", checkIfExists: true),
                    []
                ]
                """
            }
        }

        then {
            def lineages = new groovy.json.JsonSlurper().parse(path(process.out.summary[0][1]).toFile()).cells.lineages
            def rows = path(process.out.cells[0][1]).linesGzip.drop(1).collect { line -> line.split('\t', -1) as List }
            assertAll(
                { assert process.success },
                // median fractions: B 0.21, CD4T 0.17, CD8T 0.16, NK 0.15, Gran 0.15, Mono 0.14; only B reaches 0.2
                { assert lineages.B.status == 'ok' },
                { assert ['CD4T', 'CD8T', 'NK', 'Mono', 'Gran'].every { l -> lineages[l].status.startsWith('unreliable: median fraction') } },
                // the per-CpG table carries the status of its lineage
                { assert rows.findAll { r -> r[5] == 'NK' }.every { r -> r[-1].startsWith('unreliable') } }
            )
        }
    }

    test("IDOL cell fractions and outliers set to missing") {

        tag "fast"
        config "./nextflow_qi.config"

        when {
            process {
                """
                def fractions = file("$moduleTestDir/cell_fractions.tsv", checkIfExists: true)
                def idol = file("$outputDir/idol/cell_fractions.tsv")
                idol.parent.mkdirs()
                idol.text = fractions.text.replace('lineage_Gran', 'idol_Neu').replace('lineage_B', 'idol_Bcell').replace('lineage_', 'idol_')
                input[0] = [
                    [ id: 'score' ],
                    file("$moduleTestDir/model_score.json", checkIfExists: true),
                    file("$moduleTestDir/test_se", checkIfExists: true),
                    file("$moduleTestDir/samples.tsv", checkIfExists: true),
                    file("$moduleTestDir/sample_qc.tsv", checkIfExists: true),
                    file("$moduleTestDir/phenotypes.tsv", checkIfExists: true),
                    idol,
                    file("$moduleTestDir/ctrl_pcs.tsv", checkIfExists: true),
                    file("$moduleTestDir/ancestry_pcs.tsv", checkIfExists: true),
                    []
                ]
                """
            }
        }

        then {
            def summary = new groovy.json.JsonSlurper().parse(path(process.out.summary[0][1]).toFile())
            def rows = path(process.out.stats[0][1]).linesGzip
            def column = rows[0].split('\t').toList().indexOf('n')
            def tested = rows.drop(1).collect { line -> line.split('\t', -1)[column] as int }
            assertAll(
                { assert process.success },
                // the IDOL fractions take the place of the lineages
                { assert ['cc_CD4T', 'cc_CD8T', 'cc_B', 'cc_NK', 'cc_Mono'].every { c -> c in summary.covariates } },
                // fences at one interquartile range: values are set to missing, at most 38 arrays remain per CpG
                { assert summary.outlier_values > 1000 && summary.outlier_cpgs > 500 },
                { assert tested.max() <= 38 && tested.count { n -> n < 37 } > 200 },
                { assert summary.contrasts.score.hits_fdr >= 15 }
            )
        }
    }

    test("binary trait with a block") {

        tag "fast"

        when {
            process {
                """
                input[0] = [
                    [ id: 'smoker' ],
                    file("$moduleTestDir/model_smoker.json", checkIfExists: true),
                    file("$moduleTestDir/test_se", checkIfExists: true),
                    file("$moduleTestDir/samples.tsv", checkIfExists: true),
                    file("$moduleTestDir/sample_qc.tsv", checkIfExists: true),
                    file("$moduleTestDir/phenotypes.tsv", checkIfExists: true),
                    [],
                    file("$moduleTestDir/ctrl_pcs.tsv", checkIfExists: true),
                    [],
                    []
                ]
                """
            }
        }

        then {
            def summary = new groovy.json.JsonSlurper().parse(path(process.out.summary[0][1]).toFile())
            def top = path(process.out.top[0][1]).readLines().drop(1).take(20).collect { line -> line.split('\t')[0] }
            assertAll(
                { assert process.success },
                { assert summary.contrasts.keySet() == ['yes-no'] as Set },
                { assert summary.block == 'plate' && summary.block_correlation != null },
                // at least 18 of the 20 planted CpGs in the top 20 (random noise weakens a few)
                { assert top.count { cpg -> cpg in (21..40).collect { i -> String.format('cg%08d', i) } } >= 18 },
                { assert summary.contrasts['yes-no'].lambda > 0.8 && summary.contrasts['yes-no'].lambda < 1.3 }
            )
        }
    }

    test("@smoking from the DNA methylation scores") {

        tag "fast"

        when {
            process {
                """
                input[0] = [
                    [ id: 'score_smoking' ],
                    file("$moduleTestDir/model_smoking_cov.json", checkIfExists: true),
                    file("$moduleTestDir/test_se", checkIfExists: true),
                    file("$moduleTestDir/samples.tsv", checkIfExists: true),
                    file("$moduleTestDir/sample_qc.tsv", checkIfExists: true),
                    file("$moduleTestDir/phenotypes.tsv", checkIfExists: true),
                    [],
                    [],
                    [],
                    file("$moduleTestDir/dnam_scores.tsv", checkIfExists: true)
                ]
                """
            }
        }

        then {
            def summary = new groovy.json.JsonSlurper().parse(path(process.out.summary[0][1]).toFile())
            assertAll(
                { assert process.success },
                { assert summary.covariates == ['age', 'dnam_smoking'] && summary.status == 'tested' }
            )
        }
    }

    test("bacon P value of a very strong positive association") {

        tag "fast"

        when {
            process {
                """
                input[0] = [
                    [ id: 'strong' ],
                    file("$moduleTestDir/model_strong.json", checkIfExists: true),
                    file("$moduleTestDir/test_se", checkIfExists: true),
                    file("$moduleTestDir/samples.tsv", checkIfExists: true),
                    file("$moduleTestDir/sample_qc.tsv", checkIfExists: true),
                    file("$moduleTestDir/phenotypes.tsv", checkIfExists: true),
                    [],
                    [],
                    [],
                    []
                ]
                """
            }
        }

        then {
            def lines = path(process.out.top[0][1]).readLines()
            def header = lines[0].split('\t') as List
            def row = lines[1].split('\t') as List
            def value = { name -> row[header.indexOf(name)].toDouble() }
            assertAll(
                { assert process.success },
                // 1 - P rounds to 1 in double precision, where the z value used to become infinite
                { assert value('t') > 0 && value('p_value') < 1e-16 },
                // bacon rescales z a little; the corrected P value stays on the scale of the uncorrected one
                { assert value('p_bacon') > 0 && Math.log10(value('p_bacon')) / Math.log10(value('p_value')) < 1.5 },
                { assert Math.log10(value('p_bacon')) / Math.log10(value('p_value')) > 0.5 }
            )
        }
    }

    test("fewer complete cases than min_n") {

        tag "fast"

        when {
            process {
                """
                input[0] = [
                    [ id: 'small' ],
                    file("$moduleTestDir/model_small.json", checkIfExists: true),
                    file("$moduleTestDir/test_se", checkIfExists: true),
                    file("$moduleTestDir/samples.tsv", checkIfExists: true),
                    file("$moduleTestDir/sample_qc.tsv", checkIfExists: true),
                    file("$moduleTestDir/phenotypes.tsv", checkIfExists: true),
                    [],
                    [],
                    [],
                    []
                ]
                """
            }
        }

        then {
            def summary = new groovy.json.JsonSlurper().parse(path(process.out.summary[0][1]).toFile())
            def resolved = new groovy.json.JsonSlurper().parse(path(process.out.resolved[0][1]).toFile())
            assertAll(
                { assert process.success },
                { assert summary.status.startsWith('not tested') },
                // 30 arrays outside the subset plate P1, one P1 array without a score
                { assert resolved.dropped.size() == 31 }
            )
        }
    }

    test("continuous trait - stub") {

        tag "fast"
        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id: 'score' ],
                    file("$moduleTestDir/model_score.json", checkIfExists: true),
                    file("$moduleTestDir/test_se", checkIfExists: true),
                    file("$moduleTestDir/samples.tsv", checkIfExists: true),
                    file("$moduleTestDir/sample_qc.tsv", checkIfExists: true),
                    [],
                    [],
                    [],
                    [],
                    []
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
