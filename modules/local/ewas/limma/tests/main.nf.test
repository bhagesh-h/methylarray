nextflow_process {

    name "Test Process EWAS_LIMMA"
    script "../main.nf"
    process "EWAS_LIMMA"

    tag "modules"
    tag "modules_local"
    tag "ewas"
    tag "ewas/limma"

    // Simulated data (make_fixture.R): 40 arrays, 2,000 CpGs; CpGs 1-20 are
    // associated with 'score', CpGs 21-40 with 'smoker'

    test("continuous trait with every covariate token") {

        tag "fast"

        when {
            process {
                """
                input[0] = [
                    [ id: 'score' ],
                    file("$moduleTestDir/model_score.json", checkIfExists: true),
                    file("$moduleTestDir/test_se", checkIfExists: true),
                    file("$moduleTestDir/samples.tsv", checkIfExists: true),
                    file("$moduleTestDir/sample_qc.tsv", checkIfExists: true),
                    file("$moduleTestDir/phenotypes.tsv", checkIfExists: true),
                    file("$moduleTestDir/cell_fractions.tsv", checkIfExists: true),
                    file("$moduleTestDir/ctrl_pcs.tsv", checkIfExists: true),
                    []
                ]
                """
            }
        }

        then {
            def summary = new groovy.json.JsonSlurper().parse(path(process.out.summary[0][1]).toFile())
            def top = path(process.out.top[0][1]).readLines().drop(1).take(20).collect { line -> line.split('\t')[0] }
            def stats = summary.contrasts.score
            assertAll(
                { assert process.success },
                // two arrays have no score; the tokens expand to sex, five cell lineages and two control PCs
                { assert summary.n == 38 && summary.status == 'tested' },
                { assert summary.covariates == ['age', 'predicted_sex', 'cc_CD4T', 'cc_CD8T', 'cc_B', 'cc_NK', 'cc_Mono', 'ctrlpc1', 'ctrlpc2', 'plate'] },
                // the 20 planted CpGs are the top 20 and pass FDR < 0.05, with at most two false positives
                { assert top.sort() == (1..20).collect { i -> String.format('cg%08d', i) } },
                { assert stats.hits_fdr >= 20 && stats.hits_fdr <= 22 },
                { assert stats.lambda > 0.8 && stats.lambda < 1.3 },
                { assert path(process.out.design_check[0][1]).text.contains('trait ~ plate') },
                { assert snapshot(process.out.versions).match() }
            )
        }
    }

    test("binary trait with a block") {

        tag "fast"

        when {
            process {
                """
                input[0] = [
                    [ id: 'smoker' ],
                    file("$moduleTestDir/model_smoker.json", checkIfExists: true),
                    file("$moduleTestDir/test_se", checkIfExists: true),
                    file("$moduleTestDir/samples.tsv", checkIfExists: true),
                    file("$moduleTestDir/sample_qc.tsv", checkIfExists: true),
                    file("$moduleTestDir/phenotypes.tsv", checkIfExists: true),
                    [],
                    file("$moduleTestDir/ctrl_pcs.tsv", checkIfExists: true),
                    []
                ]
                """
            }
        }

        then {
            def summary = new groovy.json.JsonSlurper().parse(path(process.out.summary[0][1]).toFile())
            def top = path(process.out.top[0][1]).readLines().drop(1).take(20).collect { line -> line.split('\t')[0] }
            assertAll(
                { assert process.success },
                { assert summary.contrasts.keySet() == ['yes-no'] as Set },
                { assert summary.block == 'plate' && summary.block_correlation != null },
                // at least 18 of the 20 planted CpGs in the top 20 (random noise weakens a few)
                { assert top.count { cpg -> cpg in (21..40).collect { i -> String.format('cg%08d', i) } } >= 18 },
                { assert summary.contrasts['yes-no'].lambda > 0.8 && summary.contrasts['yes-no'].lambda < 1.3 }
            )
        }
    }

    test("@smoking from the DNA methylation scores") {

        tag "fast"

        when {
            process {
                """
                input[0] = [
                    [ id: 'score_smoking' ],
                    file("$moduleTestDir/model_smoking_cov.json", checkIfExists: true),
                    file("$moduleTestDir/test_se", checkIfExists: true),
                    file("$moduleTestDir/samples.tsv", checkIfExists: true),
                    file("$moduleTestDir/sample_qc.tsv", checkIfExists: true),
                    file("$moduleTestDir/phenotypes.tsv", checkIfExists: true),
                    [],
                    [],
                    file("$moduleTestDir/dnam_scores.tsv", checkIfExists: true)
                ]
                """
            }
        }

        then {
            def summary = new groovy.json.JsonSlurper().parse(path(process.out.summary[0][1]).toFile())
            assertAll(
                { assert process.success },
                { assert summary.covariates == ['age', 'dnam_smoking'] && summary.status == 'tested' }
            )
        }
    }

    test("fewer complete cases than min_n") {

        tag "fast"

        when {
            process {
                """
                input[0] = [
                    [ id: 'small' ],
                    file("$moduleTestDir/model_small.json", checkIfExists: true),
                    file("$moduleTestDir/test_se", checkIfExists: true),
                    file("$moduleTestDir/samples.tsv", checkIfExists: true),
                    file("$moduleTestDir/sample_qc.tsv", checkIfExists: true),
                    file("$moduleTestDir/phenotypes.tsv", checkIfExists: true),
                    [],
                    [],
                    []
                ]
                """
            }
        }

        then {
            def summary = new groovy.json.JsonSlurper().parse(path(process.out.summary[0][1]).toFile())
            def resolved = new groovy.json.JsonSlurper().parse(path(process.out.resolved[0][1]).toFile())
            assertAll(
                { assert process.success },
                { assert summary.status.startsWith('not tested') },
                // 30 arrays outside the subset plate P1, one P1 array without a score
                { assert resolved.dropped.size() == 31 }
            )
        }
    }

    test("continuous trait - stub") {

        tag "fast"
        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id: 'score' ],
                    file("$moduleTestDir/model_score.json", checkIfExists: true),
                    file("$moduleTestDir/test_se", checkIfExists: true),
                    file("$moduleTestDir/samples.tsv", checkIfExists: true),
                    file("$moduleTestDir/sample_qc.tsv", checkIfExists: true),
                    [],
                    [],
                    [],
                    []
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
