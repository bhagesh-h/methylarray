nextflow_process {

    name "Test Process ENRICHMENT_KYCG"
    script "../main.nf"
    process "ENRICHMENT_KYCG"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "enrichment"
    tag "enrichment/kycg"

    // Simulated statistics (make_fixture.R): 100 significant CpGs, 80 of them in
    // the active TSS state with lower methylation; the EPIC v2 ChromHMM
    // knowledgebase is downloaded by KYCG_CACHE

    setup {
        run("KYCG_CACHE") {
            script "../../../kycg/cache/main.nf"
            process {
                """
                input[0] = 'EPICv2'
                """
            }
        }
    }

    test("genomic context of the significant CpGs") {

        when {
            process {
                """
                input[0] = [ [ id: 'score' ], file("$moduleTestDir/stats.tsv.gz", checkIfExists: true), file("$moduleTestDir/resolved.json", checkIfExists: true) ]
                input[1] = KYCG_CACHE.out.cache
                input[2] = file("$moduleTestDir/annotation.tsv.gz", checkIfExists: true)
                """
            }
        }

        then {
            def table = path(process.out.enrichment[0][1]).readLines().collect { line -> line.split('\t', -1) as List }
            def rows = table.drop(1).collect { values -> [table[0], values].transpose().collectEntries() }
            def summary = new groovy.json.JsonSlurper().parse(path(process.out.summary[0][1]).toFile())
            def best = { query -> rows.findAll { row -> row.query == query }.min { row -> row.p_value as double } }
            assertAll(
                { assert process.success },
                { assert summary.status == 'run' && summary.contrasts.score.significant_cpgs == 100 },
                // the planted TSS enrichment is found among all and among the lower-methylated CpGs
                { assert best('all').set == 'TssA' && (best('all').fdr as double) < 0.05 && (best('all').log2_or as double) > 1 },
                { assert best('lower').set == 'TssA' },
                // 20 higher-methylated CpGs, none in TssA: an infinite negative log2 odds ratio
                { assert rows.find { row -> row.query == 'higher' && row.set == 'TssA' }.log2_or == '-Inf' },
                { assert rows.collect { row -> row.database }.unique() == ['ChromHMM'] },
                { assert snapshot(process.out.enrichment, process.out.versions).match() }
            )
        }
    }

    test("skip_enrichment in the model") {

        when {
            process {
                """
                input[0] = [ [ id: 'score' ], file("$moduleTestDir/stats.tsv.gz", checkIfExists: true), file("$moduleTestDir/resolved_skip.json", checkIfExists: true) ]
                input[1] = KYCG_CACHE.out.cache
                input[2] = file("$moduleTestDir/annotation.tsv.gz", checkIfExists: true)
                """
            }
        }

        then {
            def summary = new groovy.json.JsonSlurper().parse(path(process.out.summary[0][1]).toFile())
            assertAll(
                { assert process.success },
                { assert summary.status == 'skipped: skip_enrichment' },
                { assert path(process.out.enrichment[0][1]).readLines().size() == 1 }
            )
        }
    }

    test("genomic context - stub") {

        tag "fast"
        options "-stub"

        when {
            process {
                """
                input[0] = [ [ id: 'score' ], file("$moduleTestDir/stats.tsv.gz", checkIfExists: true), file("$moduleTestDir/resolved.json", checkIfExists: true) ]
                input[1] = []
                input[2] = file("$moduleTestDir/annotation.tsv.gz", checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
