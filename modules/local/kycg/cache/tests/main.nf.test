nextflow_process {

    name "Test Process KYCG_CACHE"
    script "../main.nf"
    process "KYCG_CACHE"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "kycg"
    tag "kycg/cache"

    // Downloads the EPIC v2 ChromHMM knowledgebase (3.5 MB) from ExperimentHub

    test("EPIC v2 ChromHMM knowledgebase") {

        when {
            process {
                """
                input[0] = 'EPICv2'
                """
            }
        }

        then {
            def resources = path(process.out.resources[0]).readLines()
            assertAll(
                { assert process.success },
                { assert resources[0] == 'database\ttitle\teh_id\tmd5' },
                { assert resources.drop(1).collect { line -> line.split('\t')[0..2] } == [['ChromHMM', 'KYCG.EPICv2.ChromHMM.20220303', 'EH8073']] },
                { assert snapshot(process.out.resources, process.out.versions).match() }
            )
        }
    }

    test("unknown database") {

        tag "fast"

        config "./nextflow_unknown.config"

        when {
            process {
                """
                input[0] = 'EPICv2'
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains('Unknown KnowYourCG databases for EPICv2: Nonsense') }
            )
        }
    }

    test("EPIC v2 - stub") {

        tag "fast"
        options "-stub"

        when {
            process {
                """
                input[0] = 'EPICv2'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
