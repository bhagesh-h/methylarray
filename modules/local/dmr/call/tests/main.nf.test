nextflow_process {

    name "Test Process DMR_CALL"
    script "../main.nf"
    process "DMR_CALL"

    tag "modules"
    tag "modules_local"
    tag "dmr"
    tag "dmr/call"

    // Simulated data (make_fixture.R): CpGs 101-115 (chr1, 20,000-21,400 bp)
    // form a region associated with the trait

    test("planted region") {

        tag "fast"

        when {
            process {
                """
                input[0] = [
                    [ id: 'score' ],
                    file("$moduleTestDir/stats.tsv.gz", checkIfExists: true),
                    file("$moduleTestDir/resolved.json", checkIfExists: true),
                    file("$moduleTestDir/test_se", checkIfExists: true)
                ]
                input[1] = file(params.dmrff_source, checkIfExists: true)
                """
            }
        }

        then {
            def read = { channel -> def lines = path(channel[0][1]).readLines(); def h = lines[0].split('\t') as List; lines.drop(1).collect { l -> [h, l.split('\t', -1) as List].transpose().collectEntries() } }
            def dmrcate = read(process.out.dmrcate)
            def dmrff = read(process.out.dmrff)
            def consensus = read(process.out.consensus)
            assertAll(
                { assert process.success },
                // both methods find the planted region, and only it
                { assert dmrcate.size() == 1 && dmrcate[0].chr == 'chr1' && (dmrcate[0].start as int) <= 20400 && (dmrcate[0].end as int) >= 21000 },
                { assert dmrff.size() >= 1 && dmrff.every { r -> r.chr == 'chr1' && (r.start as int) >= 19500 && (r.end as int) <= 21900 } },
                { assert consensus.size() >= 1 && consensus.every { r -> r.genes == 'GENEA' } },
                { assert path(process.out.bed[0][1]).readLines().size() == consensus.size() },
                { assert snapshot(process.out.versions).match() }
            )
        }
    }

    test("skip_dmr") {

        tag "fast"

        when {
            process {
                """
                input[0] = [
                    [ id: 'skipped' ],
                    file("$moduleTestDir/stats.tsv.gz", checkIfExists: true),
                    file("$moduleTestDir/resolved_skip.json", checkIfExists: true),
                    file("$moduleTestDir/test_se", checkIfExists: true)
                ]
                input[1] = file(params.dmrff_source, checkIfExists: true)
                """
            }
        }

        then {
            def summary = new groovy.json.JsonSlurper().parse(path(process.out.summary[0][1]).toFile())
            assertAll(
                { assert process.success },
                { assert summary.status == 'skipped: skip_dmr' }
            )
        }
    }

    test("planted region - stub") {

        tag "fast"
        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id: 'score' ],
                    file("$moduleTestDir/stats.tsv.gz", checkIfExists: true),
                    file("$moduleTestDir/resolved.json", checkIfExists: true),
                    file("$moduleTestDir/test_se", checkIfExists: true)
                ]
                input[1] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
