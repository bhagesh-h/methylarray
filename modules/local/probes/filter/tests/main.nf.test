nextflow_process {

    name "Test Process PROBES_FILTER"
    script "../main.nf"
    process "PROBES_FILTER"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "probes"
    tag "probes/filter"

    // A made-up SummarizedExperiment (make_fixture.R): 16 probes, each built to
    // hit one filter rule, and four arrays of which S4 failed sample QC

    test("every filter rule, replicate probes collapsed") {

        tag "fast"

        when {
            params {
                replicate_probe_strategy = 'mean'
            }
            process {
                """
                input[0] = [
                    [ id: 'test' ],
                    file("$moduleTestDir/test_se", checkIfExists: true),
                    file("$moduleTestDir/retained.txt", checkIfExists: true),
                    file("$moduleTestDir/annotation.tsv.gz", checkIfExists: true),
                    []
                ]
                """
            }
        }

        then {
            def attrition = path(process.out.attrition[0][1]).readLines().drop(1).collectEntries { line ->
                def f = line.split('\t'); [ f[0], [ removed: f[1] as int, remaining: f[2] as int, n: f[3] as int ] ]
            }
            def exclusions = path(process.out.exclusions[0][1]).linesGzip.drop(1).collectEntries { line ->
                def f = line.split('\t'); [ f[0], [ first: f[1], reasons: f[2] ] ]
            }
            assertAll(
                { assert process.success },
                // one probe per rule; S4 (failed QC) does not count for the detection rule
                { assert attrition.collectEntries { step, row -> [ step, row.removed ] } == [
                    start: 0, probe_type: 1, non_cg: 1, no_position: 1, sex_chromosome: 2, detection: 1,
                    bead_or_quality_mask: 1, snp: 1, zhou_general_mask: 1, cross_hybridisation: 1,
                    report_only_mismatch_pos: 0, report_only_zhou_uncorr_titration: 0, report_only_illumina_flagged: 0 ] },
                { assert attrition.cross_hybridisation.remaining == 6 },
                // report-only flag counted among the kept probes
                { assert attrition.report_only_mismatch_pos.n == 1 },
                // Illumina flagged probes: one kept, one removed by the Zhou mask; no mapping row without a list
                { assert attrition.report_only_illumina_flagged.n == 1 && !attrition.containsKey('report_only_illumina_mapping_inaccuracy') },
                // a probe with two reasons is removed at the first and lists both
                { assert exclusions['cg00000015_TC11'] == [ first: 'sex_chromosome', reasons: 'sex_chromosome;detection' ] },
                // the population-specific SNP mask is not applied with common_1pt, the BLAT-only probe is kept with wgbs
                { assert !exclusions.containsKey('cg00000014_TC11') && !exclusions.containsKey('cg00000012_TC11') },
                { assert !exclusions.containsKey('cg00000001_TC11') },
                // the replicate pair cg00000002 is collapsed to one CpG
                { assert path(process.out.multiqc[0][1]).text.contains('16 probes at the start, 6 kept; 5 CpGs after collapsing') },
                { assert path(process.out.se[0][1]).list().collect { f -> f.fileName.toString() }.sort() == ['assays.h5', 'se.rds'] },
                { assert snapshot(process.out.attrition, process.out.exclusions, process.out.multiqc, process.out.versions).match() }
            )
        }
    }

    test("exclusion list and Illumina lists removed") {

        tag "fast"

        when {
            params {
                replicate_probe_strategy = 'mean'
                illumina_filter          = true
            }
            process {
                """
                input[0] = [
                    [ id: 'test' ],
                    file("$moduleTestDir/test_se", checkIfExists: true),
                    file("$moduleTestDir/retained.txt", checkIfExists: true),
                    file("$moduleTestDir/annotation.tsv.gz", checkIfExists: true),
                    file("$moduleTestDir/exclude.csv", checkIfExists: true)
                ]
                """
            }
        }

        then {
            def removed = path(process.out.attrition[0][1]).readLines().drop(1).collectEntries { line ->
                def f = line.split('\t'); [ f[0], f[1] as int ]
            }
            assertAll(
                { assert process.success },
                // one flagged probe is left for the Illumina step (the other fails the Zhou mask) and is no longer report-only
                { assert removed.illumina_flagged == 1 && !removed.containsKey('report_only_illumina_flagged') },
                // a CpG name removes both replicates, a probe ID one probe; the header and the rs entry of the list do not count
                { assert removed.exclusion_list == 3 },
                { assert path(process.out.multiqc[0][1]).text.contains('16 probes at the start, 2 kept') }
            )
        }
    }

    test("only the sex chromosomes removed, replicate probes kept") {

        tag "fast"

        when {
            params {
                replicate_probe_strategy = 'none'
                probe_filters            = 'sex_chromosome'
            }
            process {
                """
                input[0] = [
                    [ id: 'test' ],
                    file("$moduleTestDir/test_se", checkIfExists: true),
                    file("$moduleTestDir/retained.txt", checkIfExists: true),
                    file("$moduleTestDir/annotation.tsv.gz", checkIfExists: true),
                    []
                ]
                """
            }
        }

        then {
            def rows = path(process.out.attrition[0][1]).readLines().drop(1).collect { line -> line.split('\t') as List }
            def removed = rows.findAll { r -> !r[0].startsWith('report_only') }.collectEntries { r -> [ r[0], r[1] as int ] }
            def flagged = rows.findAll { r -> r[0].startsWith('report_only') }.collectEntries { r -> [ r[0] - 'report_only_', r[3] as int ] }
            assertAll(
                { assert process.success },
                // the genotyping probe is always removed
                { assert removed == [ start: 0, probe_type: 1, sex_chromosome: 2 ] },
                // probes of the other steps are kept and counted
                { assert flagged.subMap(['non_cg', 'no_position', 'detection', 'snp', 'zhou_general_mask', 'cross_hybridisation']).values().every { n -> n == 1 } },
                { assert path(process.out.multiqc[0][1]).text.contains('16 probes at the start, 13 kept; 13 rows, one per probe') }
            )
        }
    }

    test("only duplicate probes removed") {

        tag "fast"

        when {
            params {
                replicate_probe_strategy = 'best'
                probe_filters            = 'none'
            }
            process {
                """
                input[0] = [
                    [ id: 'test' ],
                    file("$moduleTestDir/test_se", checkIfExists: true),
                    file("$moduleTestDir/retained.txt", checkIfExists: true),
                    file("$moduleTestDir/annotation.tsv.gz", checkIfExists: true),
                    []
                ]
                """
            }
        }

        then {
            def removed = path(process.out.attrition[0][1]).readLines().drop(1).findAll { line -> !line.startsWith('report_only') }.collectEntries { line ->
                def f = line.split('\t'); [ f[0], f[1] as int ]
            }
            def exclusions = path(process.out.exclusions[0][1]).linesGzip.drop(1).collectEntries { line -> def f = line.split('\t'); [ f[0], f[1] ] }
            assertAll(
                { assert process.success },
                { assert removed == [ start: 0, probe_type: 1, replicate_probe: 1 ] },
                // equal detection: the first probe ID stays
                { assert exclusions == [ 'rs00000003_TC11': 'probe_type', 'cg00000002_TC12': 'replicate_probe' ] },
                { assert path(process.out.multiqc[0][1]).text.contains('14 CpGs, one probe each') }
            )
        }
    }

    test("replicate probes kept") {

        tag "fast"

        when {
            params {
                replicate_probe_strategy = 'none'
            }
            process {
                """
                input[0] = [
                    [ id: 'test' ],
                    file("$moduleTestDir/test_se", checkIfExists: true),
                    file("$moduleTestDir/retained.txt", checkIfExists: true),
                    file("$moduleTestDir/annotation.tsv.gz", checkIfExists: true),
                    []
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.attrition).match() }
            )
        }
    }

    test("every filter rule - stub") {

        tag "fast"

        options "-stub"

        when {
            params {
                replicate_probe_strategy = 'mean'
            }
            process {
                """
                input[0] = [
                    [ id: 'test' ],
                    file("$moduleTestDir/test_se", checkIfExists: true),
                    file("$moduleTestDir/retained.txt", checkIfExists: true),
                    file("$moduleTestDir/annotation.tsv.gz", checkIfExists: true),
                    []
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
