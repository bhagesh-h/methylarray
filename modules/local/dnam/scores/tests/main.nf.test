nextflow_process {

    name "Test Process DNAM_SCORES"
    script "../main.nf"
    process "DNAM_SCORES"

    tag "modules"
    tag "modules_local"
    tag "dnam"
    tag "dnam/scores"

    // Simulated data (make_fixture.R): the CpGs of the four scores in
    // assets/dnam_scores, five smoking CpGs missing, one IL-6 CpG measured only
    // under a new name, and S6 failed sample QC

    test("smoking, alcohol, BMI and IL-6") {

        tag "fast"

        when {
            process {
                """
                input[0] = [
                    [ id: 'minfi' ],
                    file("$moduleTestDir/test_se", checkIfExists: true),
                    file("$moduleTestDir/retained.txt", checkIfExists: true),
                    file("$moduleTestDir/annotation.tsv.gz", checkIfExists: true)
                ]
                input[1] = file("$projectDir/assets/dnam_scores/*.tsv").findAll { f -> f.name != 'sources.tsv' }
                input[2] = file("$projectDir/assets/dnam_scores/sources.tsv", checkIfExists: true)
                """
            }
        }

        then {
            def scores = path(process.out.scores[0][1]).readLines()
            def cov = path(process.out.coverage[0][1]).readLines().collect { line -> line.split('\t', -1) as List }
            def coverage = cov.drop(1).collect { values -> [cov[0], values].transpose().collectEntries() }.collectEntries { row -> [row.score, row] }
            assertAll(
                { assert process.success },
                // S6 failed sample QC and is left out
                { assert scores[0].split('\t') as List == ['sample', 'dnam_smoking', 'dnam_alcohol', 'dnam_bmi', 'dnam_il6'] && scores.size() == 6 },
                { assert coverage.smoking.cpgs == '233' && coverage.smoking.present == '228' },
                // the renamed IL-6 CpG is found through its EPIC v1 ID
                { assert coverage.il6.present == '35' && coverage.il6.present_by_legacy_id == '1' },
                { assert coverage.values().collect { row -> row.filled_values as int }.sum() > 0 },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("smoking, alcohol, BMI and IL-6 - stub") {

        tag "fast"
        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id: 'minfi' ],
                    file("$moduleTestDir/test_se", checkIfExists: true),
                    file("$moduleTestDir/retained.txt", checkIfExists: true),
                    file("$moduleTestDir/annotation.tsv.gz", checkIfExists: true)
                ]
                input[1] = []
                input[2] = file("$projectDir/assets/dnam_scores/sources.tsv", checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
