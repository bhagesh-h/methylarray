nextflow_process {

    name "Test Process BIOMARKERS_ASSOCIATE"
    script "../main.nf"
    process "BIOMARKERS_ASSOCIATE"

    tag "modules"
    tag "modules_local"
    tag "biomarkers"
    tag "biomarkers/associate"

    // Simulated data (make_fixture.py): 80 arrays, two failed sample QC; the
    // Horvath acceleration rises with BMI, plate P3 shifts the Hannum
    // acceleration, the SNP outlier score rises with the Hannum acceleration and
    // three arrays have a borderline SNP outlier score; ancestry PC1 rises with
    // the Horvath acceleration

    test("clocks, scores, cells and phenotypes") {

        tag "fast"

        when {
            process {
                """
                input[0] = [
                    [ id: 'biomarkers' ],
                    file("$moduleTestDir/samples.tsv", checkIfExists: true),
                    file("$moduleTestDir/sample_qc.tsv", checkIfExists: true),
                    file("$moduleTestDir/clocks.tsv", checkIfExists: true),
                    file("$moduleTestDir/cell_fractions.tsv", checkIfExists: true),
                    file("$moduleTestDir/dnam_scores.tsv", checkIfExists: true),
                    file("$moduleTestDir/phenotypes.tsv", checkIfExists: true),
                    file("$moduleTestDir/ancestry_pcs.tsv", checkIfExists: true)
                ]
                """
            }
        }

        then {
            def read = { channel -> def t = path(channel[0][1]).readLines().collect { line -> line.split('\t', -1) as List }
                t.drop(1).collect { values -> [t[0], values].transpose().collectEntries() } }
            def phenotypes = read(process.out.phenotypes)
            def batch = read(process.out.batch)
            def quartiles = read(process.out.quartiles)
            def contamination = read(process.out.contamination)
            def ancestry = read(process.out.ancestry)
            assertAll(
                { assert process.success },
                // the three-level 'group' column is left out, 'mets' is binary
                { assert phenotypes.collect { row -> row.trait }.unique().sort() == ['Age', 'Men', 'bmi', 'mets (yes)'] },
                { assert phenotypes.find { row -> row.measure == 'HorvathS2013 acceleration' && row.trait == 'bmi' && row.version == 'plain' }.q as double < 0.05 },
                { assert batch.find { row -> row.measure == 'HannumG2013 acceleration' && row.batch == 'DNA plate' }.p as double < 0.05 },
                { assert quartiles.find { row -> row.measure == 'HorvathS2013 acceleration' && row.trait == 'bmi' && row.group == 'accelerated' }.p_trend as double < 0.05 },
                { assert read(process.out.agreement).size() == 6 },
                // contamination: the planted correlation, three arrays above the cutoff, left out of the 'low contamination' version
                { assert contamination.find { row -> row.measure == 'HannumG2013 acceleration' }.q as double < 0.05 },
                { assert contamination.every { row -> row.arrays_above_cutoff == '3' } },
                { assert phenotypes.findAll { row -> row.version == 'low contamination' && row.trait == 'bmi' }.every { row -> row.n == '75' } },
                // ancestry: the planted correlation, and the 'ancestry held' version of the phenotype tests
                { assert ancestry.find { row -> row.measure == 'HorvathS2013 acceleration' && row.pc == 'ancestry_pc1' }.q as double < 0.05 },
                { assert phenotypes.collect { row -> row.version }.unique().sort() == ['ancestry held', 'cells held', 'low contamination', 'plain'] },
                { assert process.out.multiqc[0][1].size() == 5 },
                { assert snapshot(process.out.agreement, process.out.cells_measures, process.out.cells_phenotypes, process.out.batch,
                                  process.out.phenotypes, process.out.quartiles, process.out.contamination, process.out.ancestry, process.out.versions).match() }
            )
        }
    }

    test("no phenotype table or ages - sex is the only phenotype") {

        tag "fast"

        when {
            process {
                """
                input[0] = [
                    [ id: 'biomarkers' ],
                    file("$moduleTestDir/samples_no_age.tsv", checkIfExists: true),
                    file("$moduleTestDir/sample_qc.tsv", checkIfExists: true),
                    file("$moduleTestDir/clocks.tsv", checkIfExists: true),
                    file("$moduleTestDir/cell_fractions.tsv", checkIfExists: true),
                    file("$moduleTestDir/dnam_scores.tsv", checkIfExists: true),
                    [], []
                ]
                """
            }
        }

        then {
            // MultiQC needs the heatmap categories as lists, also with a single column
            def heatmap = new groovy.json.JsonSlurper().parse(file(process.out.multiqc[0][1].find { f -> f.toString().endsWith('_phenotypes_mqc.json') }))
            assertAll(
                { assert process.success },
                { assert heatmap.xcats == ['Men'] },
                { assert heatmap.ycats instanceof List },
                { assert heatmap.data.every { row -> row instanceof List && row.size() == 1 } }
            )
        }
    }

    test("clocks only - stub") {

        tag "fast"
        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id: 'biomarkers' ],
                    file("$moduleTestDir/samples.tsv", checkIfExists: true),
                    file("$moduleTestDir/sample_qc.tsv", checkIfExists: true),
                    file("$moduleTestDir/clocks.tsv", checkIfExists: true),
                    [], [], [], []
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
