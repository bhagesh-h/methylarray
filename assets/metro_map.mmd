%%metro title: methylarray
%%metro style: nfcore
%%metro file: samplesheet_in | CSV | Samplesheet
%%metro files: idat_in | IDAT
%%metro file: models_in | YAML | Models
%%metro file: matrices_out | HDF5 | Betas
%%metro file: ewas_out | TSV | EWAS
%%metro file: report_out | HTML | Report
%%metro off_track: idat_in, models_in, matrices_out, ewas_out
%%metro line: minfi | minfi (default) | #0072B2
%%metro line: sesame | SeSAMe | #009E73
%%metro line: enmix | ENmix | #E69F00
%%metro line: combined | minfi + SeSAMe + ENmix | #CC79A7
%%metro legend: bl
%%metro font_scale: 1.8
%%metro stroke_scale: 2.0
%%metro section_x_gap: 20
%%metro section_y_gap: 20
%%metro center_ports: true
%%metro grid: preprocessing | 0,0
%%metro grid: qc | 1,0
%%metro grid: biology | 2,0
%%metro grid: association | 2,1
%%metro grid: regions | 1,1
%%metro grid: report | 0,1

graph LR
    subgraph preprocessing [Preprocessing]
        samplesheet_in[ ]
        idat_in[ ]
        sesame[SeSAMe]
        minfi[minfi]
        enmix[ENmix]

        samplesheet_in -->|minfi,enmix,combined| minfi
        idat_in -->|minfi,enmix,combined| minfi
        samplesheet_in -->|sesame| sesame
        idat_in -->|sesame| sesame
        minfi -->|enmix,combined| enmix
    end

    subgraph qc [QC and probe filtering]
        ewastools[ewastools]
        manifest[EPICv2manifest]
        masks[InfiniumAnnotation]
        matrices_out[ ]

        ewastools -->|minfi,sesame,enmix,combined| manifest
        manifest -->|minfi,sesame,enmix,combined| masks
        masks -->|minfi,sesame,enmix,combined| matrices_out
    end

    subgraph biology [Cells, clocks and PCA]
        epidish[EpiDISH]
        clocks[dnaMethyAge]
        pace[DunedinPACE]
        isva[isva]

        epidish -->|minfi,sesame,enmix,combined| clocks
        clocks -->|minfi,sesame,enmix,combined| pace
        pace -->|minfi,sesame,enmix,combined| isva
    end

    subgraph association [Association]
        %%metro direction: RL
        models_in[ ]
        limma[limma]
        bacon[bacon]
        ewas_out[ ]

        models_in -->|minfi,sesame,enmix,combined| limma
        limma -->|minfi,sesame,enmix,combined| bacon
        bacon -->|minfi,sesame,enmix,combined| ewas_out
    end

    subgraph regions [Regions and enrichment]
        %%metro direction: RL
        dmrcate[DMRcate]
        dmrff[dmrff]
        missmethyl[missMethyl]
        go[GO]
        kegg[KEGG]
        msigdb[MSigDB]

        dmrcate -->|minfi,sesame,enmix,combined| missmethyl
        dmrff -->|minfi,sesame,enmix,combined| missmethyl
        missmethyl -->|minfi,sesame,enmix,combined| go
        missmethyl -->|minfi,sesame,enmix,combined| kegg
        missmethyl -->|minfi,sesame,enmix,combined| msigdb
    end

    subgraph report [Report]
        %%metro direction: RL
        multiqc[MultiQC]
        quarto[Quarto]
        report_out[ ]

        multiqc -->|minfi,sesame,enmix,combined| quarto
        quarto -->|minfi,sesame,enmix,combined| report_out
    end

    %% Inter-section edges
    minfi -->|minfi| ewastools
    sesame -->|sesame| ewastools
    enmix -->|enmix,combined| ewastools
    masks -->|minfi,sesame,enmix,combined| epidish
    isva -->|minfi,sesame,enmix,combined| limma
    bacon -->|minfi,sesame,enmix,combined| dmrcate
    bacon -->|minfi,sesame,enmix,combined| dmrff
    go -->|minfi,sesame,enmix,combined| multiqc
    kegg -->|minfi,sesame,enmix,combined| multiqc
    msigdb -->|minfi,sesame,enmix,combined| multiqc
