%%metro title: methylarray
%%metro style: nfcore
%%metro output: ../docs/images/metro_map.svg
%%metro file: samplesheet_in | CSV | Samplesheet
%%metro files: idat_in | IDAT
%%metro file: models_in | YAML | Models
%%metro file: matrices_out | HDF5 | Betas
%%metro file: ewas_out | TSV | EWAS
%%metro file: report_out | HTML | Reports
%%metro off_track: idat_in, models_in, matrices_out, ewas_out
%%metro line: sesame | SeSAMe | #009E73
%%metro line: minfi | minfi (default) | #0072B2
%%metro line: combined | minfi + SeSAMe + ENmix | #CC79A7
%%metro line: enmix | ENmix | #E69F00
%%metro marker: concordance | square, open
%%metro marker_legend: square, open | Parallel mode only
%%metro legend: bl
%%metro font_scale: 1.25
%%metro section_x_gap: 30
%%metro section_y_gap: 40
%%metro grid: inputs | 0,0
%%metro grid: preprocessing | 1,0
%%metro grid: sample_qc | 2,0
%%metro grid: probe_filter | 3,0
%%metro grid: reporting | 0,1
%%metro grid: association | 1,1
%%metro grid: exploratory | 2,1
%%metro grid: biology | 3,1

graph LR
    subgraph inputs [Input]
        samplesheet_in[ ]
        idat_in[ ]
        validate[nf-schema]
        refcache[sesameData]

        samplesheet_in -->|sesame,minfi,combined,enmix| validate
        idat_in -->|sesame,minfi,combined,enmix| validate
        validate -->|sesame,combined| refcache
    end

    subgraph preprocessing [Preprocessing]
        sesame_read[readIDATpair]
        minfi_read[read.metharray.exp]
        sesame_prep[prepSesame]
        minfi_detp[detectionP]
        poobah[pOOBAH]
        enmix_qc[QCinfo]
        minfi_norm[preprocessNoob]
        enmix_norm[preprocessENmix]
        rcp[rcp]

        sesame_read -->|sesame| sesame_prep
        minfi_read -->|minfi| minfi_detp
        minfi_detp -->|minfi| minfi_norm
        minfi_read -->|combined| poobah
        poobah -->|combined| enmix_norm
        minfi_read -->|enmix| enmix_qc
        enmix_qc -->|enmix| enmix_norm
        enmix_norm -->|combined,enmix| rcp
    end

    subgraph sample_qc [Sample QC]
        controls[control_metrics]
        sexcheck[check_sex]
        identity[call_genotypes]
        qc_status[QC status]

        controls -->|sesame,minfi,combined,enmix| sexcheck
        sexcheck -->|sesame,minfi,combined,enmix| identity
        identity -->|sesame,minfi,combined,enmix| qc_status
    end

    subgraph probe_filter [Probe filtering]
        detection_filter[Detection]
        probe_masks[EPICv2manifest]
        collapse[Collapse]
        matrices_out[ ]

        detection_filter -->|sesame,minfi,combined,enmix| probe_masks
        probe_masks -->|sesame,minfi,combined,enmix| collapse
        collapse -->|sesame,minfi,combined,enmix| matrices_out
    end

    subgraph biology [Cells and clocks]
        %%metro direction: RL
        epidish[EpiDISH]
        clocks[dnaMethyAge]
        pace[DunedinPACE]
        scores[Scores]

        epidish -->|sesame,minfi,combined,enmix| clocks
        clocks -->|sesame,minfi,combined,enmix| pace
        pace -->|sesame,minfi,combined,enmix| scores
    end

    subgraph exploratory [Exploration]
        %%metro direction: RL
        ctrl_pcs[Control PCs]
        pca[PCA]
        varpart[variancePartition]
        design[Design check]

        ctrl_pcs -->|sesame,minfi,combined,enmix| pca
        pca -->|sesame,minfi,combined,enmix| varpart
        varpart -->|sesame,minfi,combined,enmix| design
    end

    subgraph association [Association]
        %%metro direction: RL
        models_in[ ]
        limma[limma]
        bacon[bacon]
        ewas_out[ ]
        dmrcate[DMRcate]
        dmrff[dmrff]
        consensus[DMRs]
        enrich[missMethyl]

        models_in -->|sesame,minfi,combined,enmix| limma
        limma -->|sesame,minfi,combined,enmix| bacon
        bacon -->|sesame,minfi,combined,enmix| ewas_out
        bacon -->|sesame,minfi,combined,enmix| dmrcate
        bacon -->|sesame,minfi,combined,enmix| dmrff
        dmrcate -->|sesame,minfi,combined,enmix| consensus
        dmrff -->|sesame,minfi,combined,enmix| consensus
        consensus -->|sesame,minfi,combined,enmix| enrich
    end

    subgraph reporting [Report]
        %%metro direction: RL
        concordance[Concordance]
        multiqc[MultiQC]
        quarto[Quarto]
        report_out[ ]

        concordance -->|sesame,minfi,combined,enmix| multiqc
        multiqc -->|sesame,minfi,combined,enmix| quarto
        quarto -->|sesame,minfi,combined,enmix| report_out
    end

    %% Inter-section edges
    refcache -->|sesame| sesame_read
    validate -->|minfi,enmix| minfi_read
    refcache -->|combined| minfi_read
    sesame_prep -->|sesame| controls
    minfi_norm -->|minfi| controls
    rcp -->|combined,enmix| controls
    qc_status -->|sesame,minfi,combined,enmix| detection_filter
    collapse -->|sesame,minfi,combined,enmix| epidish
    scores -->|sesame,minfi,combined,enmix| ctrl_pcs
    design -->|sesame,minfi,combined,enmix| limma
    enrich -->|sesame,minfi,combined,enmix| concordance
