/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    bhagesh-h/methylarray Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// Global default params, used in configs
params {

    // Input options
    input                      = null
    phenotypes                 = null
    models                     = null

    // Array platform and preprocessing
    platform                   = 'EPICv2'
    preprocessing              = 'minfi'
    sesame_prep                = 'QCDPB'
    minfi_norm                 = 'noob'
    enmix_quantile             = false
    min_beads                  = 3
    minfi_chunk_size           = 40
    detection_pval             = 0.05
    sesame_cache               = null
    save_reference             = false

    // Sample QC
    skip_ewastools             = false
    ewastools_source           = 'https://github.com/hhhh5/ewastools/archive/d7d0a3295177b2528248966012f635be881f78ab.tar.gz'
    max_undetected_fraction    = 0.1
    snp_outlier_threshold      = -4

    // Probe annotation and filtering
    probe_annotation           = null
    probe_manifest_source      = 'https://annotationhub.bioconductor.org/fetch/123230'
    illumina_flagged_probes    = null
    illumina_mapping_inaccuracy = null
    probe_mask_source          = 'https://raw.githubusercontent.com/zhou-lab/InfiniumAnnotationV1/175566c157b8cb902ba6d9d7525547fca41adbe5/Anno/EPICv2/EPICv2.hg38.mask.tsv.gz'
    probe_fail_fraction        = 0.1
    bead_fail_fraction         = 0.05
    crosshyb_filter            = 'wgbs'
    snp_mask                   = 'common_1pt'
    keep_sex_chr               = false
    replicate_probe_strategy   = 'mean'

    // Cell composition
    tissue                     = 'blood'
    min_reference_coverage     = 0.9
    skip_idol                  = false
    idol_reference             = 'https://raw.githubusercontent.com/immunomethylomics/FlowSorted.Blood.EPIC/b837178f81082ba386a13d5669d08dd8d3df6222/data/IDOLOptimizedCpGs.compTable.rda'

    // Epigenetic clocks
    skip_clocks                = false
    clocks                     = 'HorvathS2013,HannumG2013,LevineM2018,HorvathS2018,ZhangQ2019,LuA2019,ZhangY2017,PCGrimAge,PCPhenoAge,PCHorvathS2013,PCHannumG2013,PCHorvathS2018,FuentealbaM2025,epiTOC2,DunedinPACE'
    dunedinpace_min_probes     = 0.8
    dnamethyage_source         = 'https://github.com/yiluyucheng/dnaMethyAge/archive/0d40c9bb02c7d9a4d91ce01d150a9c0b12edf1f4.tar.gz'
    meqtl                      = null
    meqtl_p                    = 1e-8
    dunedinpace_source         = 'https://github.com/danbelsky/DunedinPACE/archive/4b569983543e51d1022aecec9a25e694bb3a336a.tar.gz'

    // DNA methylation scores
    skip_dnam_scores           = false
    dnam_scores                = 'smoking,alcohol,bmi,il6'

    // Exploratory analysis
    n_variable_cpgs            = 50000
    n_pcs                      = 'auto'
    n_ctrl_pcs                 = 'auto'
    skip_ancestry              = false
    skip_variance_partition    = false
    variance_partition_cpgs    = 20000
    n_ancestry_pcs             = 4

    // Association models
    p_epigenome_wide           = 9e-8
    p_suggestive               = 1e-5
    skip_cell_ewas             = false

    // Differentially methylated regions
    skip_dmr                   = false
    dmr_lambda                 = 1000
    dmr_c                      = 2
    dmr_min_cpgs               = 2
    dmrff_source               = 'https://github.com/perishky/dmrff/archive/8e0469e5238c4c2de84746af143a733600537be4.tar.gz'

    // Gene set enrichment
    skip_enrichment            = false
    enrichment_min_hits        = 10
    enrichment_collections     = 'GO,KEGG'
    skip_kycg                  = false
    kycg_databases             = 'ChromHMM,TFBS,HM,CTCFbind,ABCompartment,ImprintingDMR,MetagenePC'
    kycg_cache                 = null
    gene_set_gmts              = 'https://data.broadinstitute.org/gsea-msigdb/msigdb/release/2025.1.Hs/h.all.v2025.1.Hs.entrez.gmt,https://data.broadinstitute.org/gsea-msigdb/msigdb/release/2025.1.Hs/c2.cp.reactome.v2025.1.Hs.entrez.gmt'

    // Report
    skip_report                = false
    export_geo                 = false

    // MultiQC options
    multiqc_config             = null
    multiqc_title              = null
    multiqc_logo               = null
    max_multiqc_email_size     = '25.MB'
    multiqc_methods_description = null

    // Boilerplate options
    outdir                       = null
    publish_dir_mode             = 'copy'
    email                        = null
    email_on_fail                = null
    plaintext_email              = false
    monochrome_logs              = false
    help                         = false
    help_full                    = false
    show_hidden                  = false
    version                      = false
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/'
    trace_report_suffix          = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')

    // Config options
    config_profile_name        = null
    config_profile_description = null

    custom_config_version      = 'master'
    custom_config_base         = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
    config_profile_contact     = null
    config_profile_url         = null

    // Schema validation default options
    validate_params            = true
}

// Backwards compatibility for publishDir syntax
outputDir = params.outdir
workflow.output.mode = params.publish_dir_mode

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

profiles {
    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
        nextflow.enable.configProcessNamesValidation = true
    }
    conda {
        conda.enabled           = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        conda.channels          = ['conda-forge', 'bioconda']
        apptainer.enabled       = false
    }
    mamba {
        conda.enabled           = true
        conda.useMamba          = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    docker {
        docker.enabled          = true
        conda.enabled           = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        docker.runOptions       = '-u $(id -u):$(id -g)'
    }
    arm64 {
        process.arch            = 'arm64'
        // TODO https://github.com/nf-core/modules/issues/6694
        // For now if you're using arm64 you have to use wave for the sake of the maintainers
        // wave profile
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    emulate_amd64 {
        docker.runOptions       = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        conda.enabled           = false
        docker.enabled          = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    podman {
        podman.enabled          = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    shifter {
        shifter.enabled         = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    charliecloud {
        charliecloud.enabled    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        apptainer.enabled       = false
    }
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
    }
    wave {
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    gpu {
        docker.runOptions       = '-u $(id -u):$(id -g) --gpus all'
        apptainer.runOptions    = '--nv'
        singularity.runOptions  = '--nv'
    }
    test      { includeConfig 'conf/test.config'      }
    test_full { includeConfig 'conf/test_full.config' }
}

// Load nf-core custom profiles from different institutions

// If params.custom_config_base is set AND either the NXF_OFFLINE environment variable is not set or params.custom_config_base is a local path, the nfcore_custom.config file from the specified base path is included.
// Load bhagesh-h/methylarray custom profiles from different institutions.
includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"


// Load bhagesh-h/methylarray custom profiles from different institutions.

// Set default registry for Apptainer, Docker, Podman, Charliecloud and Singularity independent of -profile
// Will not be used unless Apptainer / Docker / Podman / Charliecloud / Singularity are enabled
// Set to your registry if you have a mirror of containers
apptainer.registry    = 'quay.io'
docker.registry       = 'quay.io'
podman.registry       = 'quay.io'
singularity.registry  = 'quay.io'
charliecloud.registry = 'quay.io'



// Export these variables to prevent local Python/R libraries from conflicting with those in the container
// The JULIA depot path has been adjusted to a fixed path `/usr/local/share/julia` that needs to be used for packages in the container.
// See https://apeltzer.github.io/post/03-julia-lang-nextflow/ for details on that. Once we have a common agreement on where to keep Julia packages, this is adjustable.

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
}

// Set bash options
process.shell = [
    "bash",
    "-C",         // No clobber - prevent output redirection from overwriting files.
    "-e",         // Exit if a tool returns a non-zero status/exit code
    "-u",         // Treat unset variables and parameters as an error
    "-o",         // Returns the status of the last command to exit..
    "pipefail"    //   ..with a non-zero status or zero if all successfully execute
]

// Disable process selector warnings by default. Use debug profile to enable warnings.
nextflow.enable.configProcessNamesValidation = false

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

manifest {
    name            = 'bhagesh-h/methylarray'
    contributors    = [
        [
            name: 'Bhagesh Hunakunti',
            affiliation: '',
            email: '',
            github: 'https://github.com/bhagesh-h',
            contribution: ['author', 'maintainer'],
            orcid: 'https://orcid.org/0000-0002-5957-8005'
        ],
    ]
    homePage        = 'https://github.com/bhagesh-h/methylarray'
    description     = """Quality control, preprocessing and association analysis of Illumina Infinium DNA methylation arrays (EPIC v2)"""
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=26.04.2'
    version         = '1.0.0'
    doi             = ''
    diagram         = 'docs/images/metro_map.svg'
}

// Nextflow plugins
plugins {
    id 'nf-schema@2.7.3' // Validation of pipeline parameters and creation of an input channel from a sample sheet
}

validation {
    defaultIgnoreParams = ["genomes"]
    monochromeLogs = params.monochrome_logs
}
// Load modules.config for DSL2 module specific options
includeConfig 'conf/modules.config'
