nextflow_pipeline {

    name "Test pipeline - combined preprocessing"
    script "../main.nf"
    tag "pipeline"
    tag "pipeline_combined"

    // minfi import, ENmix correction and the SeSAMe masks: covers the hand-over
    // of the SeSAMe SummarizedExperiment to MINFI_PREPROCESS
    test("-profile test --preprocessing combined") {

        when {
            params {
                outdir        = "$outputDir"
                preprocessing = 'combined'
            }
        }

        then {
            def stable_path = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            def stable_content = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            def qc = path("$outputDir/qc/combined/combined_qc.tsv").readLines().collect { line -> line.tokenize('\t') }
            def rows = qc.drop(1).collect { values -> [qc[0], values].transpose().collectEntries() }
            assertAll(
                { assert workflow.success },
                { assert rows.size() == 6 },
                { assert rows.every { row -> row.method == 'combined' } },
                // the SeSAMe masks (quality mask, pOOBAH) mask several percent of the values
                { assert rows.every { row -> (row.frac_masked as double) > 0.02 } },
                { assert snapshot(
                    removeNextflowVersion("$outputDir/pipeline_info/methylarray_software_mqc_versions.yml"),
                    stable_path,
                    stable_content
                ).match() }
            )
        }
    }
}
