nextflow_pipeline {

    name "Test pipeline - combined preprocessing"
    script "../main.nf"
    tag "pipeline"
    tag "pipeline_combined"

    // Stub run: covers the routing and the hand-over of the SeSAMe
    // SummarizedExperiment to MINFI_PREPROCESS. The module tests and the default
    // pipeline test process real arrays; keeping this one a stub keeps CI short.
    test("-profile test --preprocessing combined - stub") {

        tag "fast"

        options "-stub"

        when {
            params {
                outdir        = "$outputDir"
                preprocessing = 'combined'
                models        = "${projectDir}/tests/data/models_test.yml"
            }
        }

        then {
            def stable_path = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            def stable_content = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assertAll(
                { assert workflow.success },
                { assert path("$outputDir/preprocessing/combined/combined_se").exists() },
                { assert path("$outputDir/preprocessing/sesame/sesame_se").exists() },
                { assert snapshot(
                    removeNextflowVersion("$outputDir/pipeline_info/methylarray_software_mqc_versions.yml"),
                    stable_path,
                    stable_content
                ).match() }
            )
        }
    }
}
