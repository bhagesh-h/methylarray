/*
========================================================================================
    Nextflow config file for running nf-test tests
========================================================================================
*/

// Parameters and resources for the nf-test runs
params {
    modules_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/methylarray/'
}

// Fixes S3 access issues on self-hosted runners
aws.client.anonymous = true

// CI runners sometimes lose the connection while pulling a task image (Docker
// exits with 125): retry such tasks, as the pipeline does for resource errors
process {
    errorStrategy = { task.exitStatus in ((130..145) + 104 + (175..177) + 125) ? 'retry' : 'finish' }
    maxRetries    = 2
}
